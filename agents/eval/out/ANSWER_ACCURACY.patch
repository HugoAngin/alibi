+    for issuer in issuers:
+        share: dict[str, int] = {}
+        for kind in found.kinds:
+            keys = rules._FACT_KEYS.get(kind)
+            if keys is None:
+                continue
+            rows = [t for i, t in enumerate(calc.terms)
