diff --color -ruN -x _ orig/alibi/tests/test_one_pass_release_gap.py tree/alibi/tests/test_one_pass_release_gap.py
--- orig/alibi/tests/test_one_pass_release_gap.py	1970-01-01 01:00:00
+++ tree/alibi/tests/test_one_pass_release_gap.py	2026-11-08 13:15:54
@@ -0,0 +1,22 @@
+"""One-pass labels a same-amount balance release with no payout as balance_release_not_settlement
+from already-retrieved evidence (no extra model calls or lookups); no records stays no_merchant_records."""
+import pytest
+
+from agents.data.api import load_case, without_gold
+from alibi.adapter import run_cases
+from alibi.eval import scorer
+from alibi.llm.fake import FakeClient
+
+
+@pytest.mark.parametrize("number,gap", [(17, "balance_release_not_settlement"),
+                                        (18, "balance_release_not_settlement"),
+                                        (32, "no_merchant_records")])
+def test_release_only_gap_label(tmp_path, number, gap):
+    case = load_case(number)
+    client = FakeClient({"*": {"claims": [], "disclosures": [], "rationale": "offline"}})
+    run_cases([without_gold(case)], "one_pass", out=tmp_path, root=tmp_path / "stores",
+              client=client, log=lambda _: None)
+    result = scorer.run([case], [scorer.load_predictions(tmp_path / "one_pass.jsonl")])[0]
+    questions = [q for r in result.cases[0].requests for q in r.questions]
+    assert questions and all(q.predicted_status == "unresolved" and q.predicted_gap == gap for q in questions)
+    assert result.metrics["forbidden_items"] == 0
