+        claim = a["claims"][qid]
+        assert (claim["status"], claim["gap"]) == ("unresolved", "settlement_after_credit"), qid
+        assert claim["facts"] == {}
+    assert "after the booking" in a["claims"]["q.source_of_funds"]["rationale"]
