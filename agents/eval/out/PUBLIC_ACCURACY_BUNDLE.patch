+            return None
+        issuer_of[index] = issuer
+    issuers = sorted(set(issuer_of.values()))
+    if len(issuers) < 2:
+        return None
+    shares: dict[str, dict[str, int]] = {}
+    for issuer in issuers:
+        share: dict[str, int] = {}
+        for kind in found.kinds:
+            keys = rules._FACT_KEYS.get(kind)
+            if keys is None:
+                continue
+            rows = [t for i, t in enumerate(calc.terms)
