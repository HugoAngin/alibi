+def run_lockbox(command: str, commit: str, timeout: float | None) -> str:
+    with tempfile.TemporaryDirectory(prefix="lockbox-", ignore_cleanup_errors=True) as scratch:
+        into = Path(scratch) / "repo"
+        try:
+            error = checkout(commit, into)
+            if error:
+                die(error)
+            if lockbox_from(into / "shared" / "splits.json") is None:
+                die("no lockbox is set in shared/splits.json. Ask lead.")
+            return run(command, into, True, timeout)
+        finally:
+            if into.exists():
+                remove_checkout(into)
+
