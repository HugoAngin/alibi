+    def test_add_runs_and_records_the_same_commit_when_the_source_branch_advances(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+
+            def git(*args):
+                return subprocess.check_output(["git", *args], cwd=root, text=True).strip()
+
+            git("init", "-q", "--template=")
+            git("config", "user.name", "Results test")
+            git("config", "user.email", "results@example.invalid")
+            git("config", "team.login", "test-eval")
+            (root / "tools").mkdir()
+            for name in ("results.py", "lockbox.py", "team.py"):
+                shutil.copyfile(Path(__file__).with_name(name), root / "tools" / name)
+            (root / "team.json").write_text(json.dumps({"members": [
+                {"role": "eval", "github": "test-eval", "paths": ["agents/eval/"]}
+            ]}))
+            (root / "shared").mkdir()
+            (root / "shared" / "splits.json").write_text('{"lockbox_from": 1}')
+            (root / "capture.py").write_text(
+                'import json, os, subprocess\n'
+                'from pathlib import Path\n'
+                'from tools.lockbox import is_open\n'
+                'assert is_open()\n'
+                'subprocess.run(["git", "merge", "--ff-only", "advance"], '
+                'cwd=os.environ["RESULTS_TEST_ROOT"], check=True)\n'
+                'print(json.dumps({"version": int(Path("version.txt").read_text())}))\n'
+            )
+            version = root / "version.txt"
+            version.write_text("1")
+            git("add", "tools", "shared", "team.json", "capture.py", "version.txt")
+            git("commit", "-qm", "launch version", "--no-gpg-sign")
+            launch_commit = git("rev-parse", "HEAD")
+            version.write_text("2")
+            git("commit", "-qam", "later version", "--no-gpg-sign")
+            later_commit = git("rev-parse", "HEAD")
+            git("branch", "advance", later_commit)
+            git("reset", "--hard", launch_commit)
+
+            command = [sys.executable, "capture.py"]
+            shell_command = subprocess.list2cmdline(command) if os.name == "nt" else shlex.join(command)
+            done = subprocess.run(
+                [sys.executable, "tools/results.py", "add", "--split", "lockbox",
+                 "--variants", "1", "--command", shell_command],
+                cwd=root, env={**os.environ, "RESULTS_TEST_ROOT": str(root)},
+                capture_output=True, text=True, timeout=30,
+            )
+            self.assertEqual(done.returncode, 0, done.stderr)
+            record = json.loads((root / "agents/eval/out/results.jsonl").read_text())
+            self.assertEqual(git("rev-parse", "HEAD"), later_commit)
+            self.assertEqual(record["commit"], launch_commit)
+            self.assertEqual(record["metrics"], {"version": 1})
+            self.assertEqual(git("worktree", "list", "--porcelain").count("worktree "), 1)
