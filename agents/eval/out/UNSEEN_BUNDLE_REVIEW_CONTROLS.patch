+import copy
+from alibi.tests.test_agents_runner import make, client_for, challenger
+from alibi.agents.runner import run_stats
+from alibi.core.schemas import SigningDomain
+
+
+def stopped(result):
+    return any(e.result.get('stop_reason') == 'repeated_action_no_progress' for e in result.trace)
+
+
+def test_identical_lookup_returning_fresh_revisions_keeps_all_rounds(make, keystore):
+    ctx = make('supported')
+    original = ctx.fx['settlement_lookup']('PO-5001')
+    calls = []
+    def lookup(ref):
+        calls.append(ref)
+        event = copy.deepcopy(original['event'])
+        revision = len(calls)
+        event.update(event_id=f'public-fresh-{revision}', revision=revision)
+        if revision > 1:
+            event.update(corrects_revision=revision-1, correction_reason='Public test revision')
+        return {'event': event, 'signature': keystore.sign(event, kid='merchant_demo',
+                 domain=SigningDomain.RECORD).to_json_dict()}
+    result = ctx.run(client_for(challenger_script=challenger()), settlement_lookup=lookup)
+    assert len(calls) == 3
+    assert run_stats(result)['rounds'] == 3
+    assert not stopped(result)
+    assert ctx.store.get_source('stl_88001').revision == 3
+
+
+def test_repeated_refresh_with_no_new_revision_is_not_stopped(make):
+    ctx = make('supported')
+    calls = []
+    def refresh(txn_id):
+        calls.append(txn_id)
+        return ctx.store.get_bank_txn(txn_id).to_json_dict()
+    result = ctx.run(client_for(challenger_script=challenger(action=('refresh_txn', {'txn_id': 'txn_9001'}))),
+                     txn_refresh=refresh)
+    assert len(calls) == 3
+    assert run_stats(result)['rounds'] == 3
+    assert not stopped(result)
