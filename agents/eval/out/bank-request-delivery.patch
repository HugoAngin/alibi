+/** The bank can record a request before the passport accepts delivery. */
+function requestDelivery(data: unknown): ActionResult {
+  const forwarded =
+    typeof data === 'object' && data !== null && 'forwarded' in data ? data.forwarded : undefined;
+  if (forwarded === null) {
+    return {
+      kind: 'unavailable',
+      message:
+        'The bank already has this request on record. Check that it appears in the customer’s Alibi.',
+    };
+  }
+  if (typeof forwarded === 'object' && forwarded !== null && 'status' in forwarded) {
+    if (forwarded.status === 'accepted') return { kind: 'ok', data };
+    if ('reason' in forwarded && typeof forwarded.reason === 'string') {
+      if (
+        forwarded.status === 'refused' &&
+        'code' in forwarded &&
+        typeof forwarded.code === 'string'
+      ) {
+        return { kind: 'refused', refusal: { code: forwarded.code, reason: forwarded.reason } };
+      }
+      return { kind: 'unavailable', message: forwarded.reason };
+    }
+  }
+  return {
+    kind: 'unavailable',
+    message: 'The backend did not confirm delivery to the customer’s Alibi.',
+  };
+}
