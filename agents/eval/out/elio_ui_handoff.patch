diff --git a/web/apps/merchant/src/pages/seller/orders/index.astro b/web/apps/merchant/src/pages/seller/orders/index.astro
new file mode 100644
index 0000000..877c5b9
--- /dev/null
+++ b/web/apps/merchant/src/pages/seller/orders/index.astro
@@ -0,0 +1,154 @@
+---
+/** Every order and refund on Maya's account in October 2026. */
+import ShopLayout from '@/layouts/ShopLayout.astro';
+import SellerNav from '@/components/SellerNav.astro';
+import { formatGBP } from '@/data/shop';
+import { day, orders, refunds } from '@/data/account';
+---
+
+<ShopLayout title="Orders">
+  <h1>Orders</h1>
+  <SellerNav current="orders" />
+
+  <section aria-labelledby="sold-title">
+    <h2 id="sold-title">Sold ({orders.length})</h2>
+    <div class="table-wrap">
+      <table>
+        <thead>
+          <tr>
+            <th scope="col">Date</th>
+            <th scope="col">Order</th>
+            <th scope="col">Item</th>
+            <th scope="col" class="num">
+              Price
+            </th>
+            <th scope="col" class="num">
+              Seller fee
+            </th>
+            <th scope="col">Status</th>
+          </tr>
+        </thead>
+        <tbody>
+          {orders.map((o) => (
+            <tr>
+              <td data-label="Date">{day(o.soldAt)}</td>
+              <td data-label="Order">
+                <code>{o.orderRef}</code>
+              </td>
+              <td data-label="Item">{o.title}</td>
+              <td data-label="Price" class="num">
+                {formatGBP(o.priceMinor)}
+              </td>
+              <td data-label="Seller fee" class="num">
+                −{formatGBP(o.feeMinor)}
+              </td>
+              <td data-label="Status">✓ {o.status}</td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </div>
+  </section>
+
+  <section aria-labelledby="refund-title">
+    <h2 id="refund-title">Refunds ({refunds.length})</h2>
+    <div class="table-wrap">
+      <table>
+        <thead>
+          <tr>
+            <th scope="col">Date</th>
+            <th scope="col">Refund</th>
+            <th scope="col">Order</th>
+            <th scope="col">Reason</th>
+            <th scope="col" class="num">
+              Amount
+            </th>
+          </tr>
+        </thead>
+        <tbody>
+          {refunds.map((r) => (
+            <tr>
+              <td data-label="Date">{day(r.refundedAt)}</td>
+              <td data-label="Refund">
+                <code>{r.refundRef}</code>
+              </td>
+              <td data-label="Order">
+                <code>{r.orderRef}</code>
+              </td>
+              <td data-label="Reason">{r.reason}</td>
+              <td data-label="Amount" class="num">
+                −{formatGBP(r.amountMinor)}
+              </td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </div>
+  </section>
+</ShopLayout>
+
+<style>
+  section {
+    margin-block: var(--space-lg);
+  }
+
+  h2 {
+    font-size: var(--t-md);
+  }
+
+  .table-wrap {
+    overflow-x: auto;
+  }
+
+  table {
+    width: 100%;
+    border-collapse: collapse;
+  }
+
+  th,
+  td {
+    text-align: left;
+    padding: var(--space-xs);
+    border-bottom: 1px solid var(--c-line);
+  }
+
+  .num {
+    text-align: right;
+    font-variant-numeric: tabular-nums;
+  }
+
+  @media (max-width: 599px) {
+    thead {
+      position: absolute;
+      clip: rect(0 0 0 0);
+      width: 1px;
+      height: 1px;
+      overflow: hidden;
+    }
+
+    table,
+    tbody,
+    tr,
+    td {
+      display: block;
+      width: 100%;
+    }
+
+    tr {
+      padding-block: var(--space-xs);
+      border-bottom: 1px solid var(--c-line);
+    }
+
+    td {
+      border: 0;
+      padding: 0;
+      text-align: left;
+    }
+
+    td::before {
+      content: attr(data-label) ': ';
+      color: var(--c-ink-soft);
+      font-size: var(--t-sm);
+    }
+  }
+</style>
diff --git a/web/apps/merchant/src/pages/seller/payouts/index.astro b/web/apps/merchant/src/pages/seller/payouts/index.astro
new file mode 100644
index 0000000..642dd7b
--- /dev/null
+++ b/web/apps/merchant/src/pages/seller/payouts/index.astro
@@ -0,0 +1,121 @@
+---
+/** Payouts to Maya's bank account, with what each one covers. */
+import ShopLayout from '@/layouts/ShopLayout.astro';
+import SellerNav from '@/components/SellerNav.astro';
+import { formatGBP } from '@/data/shop';
+import { orders, payouts, refunds, totals, when } from '@/data/account';
+---
+
+<ShopLayout title="Payouts">
+  <h1>Payouts</h1>
+  <SellerNav current="payouts" />
+
+  {payouts.map((p) => (
+    <article class="payout" aria-labelledby={`p-${p.payoutRef}`}>
+      <h2 id={`p-${p.payoutRef}`}>
+        {formatGBP(p.amountMinor)} <code>{p.payoutRef}</code>
+      </h2>
+      <p class="status-paid">✓ {p.status}</p>
+      <dl>
+        <dt>Requested</dt>
+        <dd>{when(p.requestedAt)}</dd>
+        <dt>Arrived</dt>
+        <dd>{when(p.settledAt)}</dd>
+        <dt>Paid to</dt>
+        <dd>{p.destination}</dd>
+      </dl>
+      <h3>What it covers</h3>
+      <table>
+        <tbody>
+          <tr>
+            <td>{orders.length} orders</td>
+            <td class="num">{formatGBP(totals.salesMinor)}</td>
+          </tr>
+          <tr>
+            <td>{refunds.length} refunds</td>
+            <td class="num">−{formatGBP(totals.refundsMinor)}</td>
+          </tr>
+          <tr>
+            <td>Seller fees</td>
+            <td class="num">−{formatGBP(totals.feesMinor)}</td>
+          </tr>
+          <tr class="total">
+            <td>Paid out</td>
+            <td class="num">{formatGBP(totals.netMinor)}</td>
+          </tr>
+        </tbody>
+      </table>
+      <p class="meta">Orders {p.coversOrderRefs.join(', ')}.</p>
+    </article>
+  ))}
+
+  <p class="meta">
+    Money from a sale first becomes available in your seller balance. A payout is the transfer from
+    that balance to your bank account.
+  </p>
+</ShopLayout>
+
+<style>
+  .payout {
+    padding: var(--space-md);
+    background: var(--c-surface);
+    border: 1px solid var(--c-line);
+    border-radius: var(--radius-md);
+    max-width: var(--measure);
+  }
+
+  h2 {
+    font-size: var(--t-lg);
+    margin-bottom: var(--space-2xs);
+  }
+
+  h3 {
+    font-size: var(--t-base);
+    margin-top: var(--space-md);
+  }
+
+  .status-paid {
+    color: var(--c-ok);
+    font-weight: 700;
+  }
+
+  dl {
+    display: grid;
+    grid-template-columns: max-content 1fr;
+    gap: var(--space-3xs) var(--space-sm);
+  }
+
+  dt {
+    color: var(--c-ink-soft);
+  }
+
+  dd {
+    margin: 0;
+  }
+
+  table {
+    width: 100%;
+    border-collapse: collapse;
+  }
+
+  td {
+    padding: var(--space-3xs) 0;
+    border-bottom: 1px solid var(--c-line);
+  }
+
+  .total td {
+    font-weight: 800;
+    border-top: 2px solid var(--c-ink);
+    border-bottom: 0;
+  }
+
+  .num {
+    text-align: right;
+    font-variant-numeric: tabular-nums;
+  }
+
+  .meta {
+    color: var(--c-ink-soft);
+    font-size: var(--t-sm);
+  }
+</style>
diff --git a/web/apps/merchant/tests/account.test.ts b/web/apps/merchant/tests/account.test.ts
new file mode 100644
index 0000000..09e7efc
--- /dev/null
+++ b/web/apps/merchant/tests/account.test.ts
@@ -0,0 +1,47 @@
+import { describe, expect, it } from 'vitest';
+
+import view from '../../../../agents/data/out/merchant_view/case_0001.json';
+import { notifications, orders, payouts, purchases, refunds, totals } from '../src/data/account';
+
+// Data's marketplace view of case 1 (agents/data/out/merchant_view/case_0001.json). Read-only.
+
+describe("Maya's seller account matches data's marketplace view of case 1", () => {
+  it('copies every order, refund, payout, notification and purchase exactly', () => {
+    expect(
+      orders.map((o) => [o.orderRef, o.title, o.soldAt, o.priceMinor, o.feeMinor, o.recordId]),
+    ).toEqual(
+      view.orders.map((o) => [
+        o.order_ref,
+        o.title,
+        o.sold_at,
+        o.price_minor,
+        o.fee_minor,
+        o.record_id,
+      ]),
+    );
+    expect(
+      refunds.map((r) => [r.refundRef, r.orderRef, r.refundedAt, r.amountMinor, r.recordId]),
+    ).toEqual(
+      view.refunds.map((r) => [
+        r.refund_ref,
+        r.order_ref,
+        r.refunded_at,
+        r.amount_minor,
+        r.record_id,
+      ]),
+    );
+    expect(payouts.map((p) => [p.payoutRef, p.amountMinor, p.settledAt, p.recordId])).toEqual(
+      view.payouts.map((p) => [p.payout_ref, p.amount_minor, p.settled_at, p.record_id]),
+    );
+    expect(notifications.map((n) => n.body)).toEqual(view.notifications.map((n) => n.body));
+    expect(purchases.map((p) => p.recordId)).toEqual(view.purchases.map((p) => p.record_id));
+  });
+
+  it('adds up to the £2,160 payout', () => {
+    expect(totals.netMinor).toBe(view.totals.net_minor);
+    expect(totals.salesMinor - totals.refundsMinor - totals.feesMinor).toBe(216000);
+    expect(orders.reduce((s, o) => s + o.priceMinor, 0)).toBe(totals.salesMinor);
+    expect(orders.reduce((s, o) => s + o.feeMinor, 0)).toBe(totals.feesMinor);
+    expect(refunds.reduce((s, r) => s + r.amountMinor, 0)).toBe(totals.refundsMinor);
+  });
+});
