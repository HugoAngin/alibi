+  const nb = NORMAL[bSide];
+  const r = (n: number) => Math.round(n * 10) / 10;
+  return (
+    `M${r(a.x)} ${r(a.y)} ` +
+    `C${r(a.x + na.x * k)} ${r(a.y + na.y * k)} ${r(b.x + nb.x * k)} ${r(b.y + nb.y * k)} ` +
+    `${r(b.x)} ${r(b.y)}`
+  );
