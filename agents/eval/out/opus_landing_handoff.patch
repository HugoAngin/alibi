@@ -0,0 +1,1567 @@
+---
+/**
+ * The landing's centrepiece: a financial passport as one data stream, scrubbed by scroll
+ * (agents/research/out/HERO_STREAM.md, agents/execution/out/HANDOFF_LANDING.md). Four merchants
+ * and two bank accounts send records into the Alibi engine. Four agents work on them, including
+ * a mule-pattern question on a hop between the two banks, and code checks the result. NatWest's
+ * fraud desk asks one question, the holder approves what leaves, and a signed context package
+ * arrives at the desk. It replaces Hero and Core: the engine, both integration buttons and the
+ * holder's approval all live on the board.
+ *
+ * Nodes are HTML, so the real shared buttons work from here. Wires are one SVG overlay whose
+ * paths the script computes from node rectangles; nodes are never transformed, so anchors hold.
+ * The timeline (stages, flows, windows, geometry) is pure and tested in src/lib/stream.ts.
+ *
+ * Without JavaScript, or with reduced motion, the section is one still final frame: every state
+ * as it is at p = 1. The scrubbed states sit behind a media query, so the first paint is already
+ * right either way. The animated presses and approval are illustrations: scrolling never clicks
+ * anything. Names are real merchants and banks drawn as colour tiles in our own type, not their
+ * logos, and everything on the board is illustrative and synthetic.
+ */
+import { Show } from '@clerk/astro/components';
+import ConnectAlibiButton from '@alibi/ui/ConnectAlibiButton.astro';
+import Logomark from '@alibi/ui/Logomark.astro';
+import RequestAlibiButton from '@alibi/ui/RequestAlibiButton.astro';
+
+import { product } from '@/data/product';
+import { FLOWS, MULE, STAGES } from '@/lib/stream';
+
+const origin = Astro.url.origin;
+const returnTo = `${origin}/#core`;
+
+/** Each merchant's "Connect to my Alibi" is pressed, then the tile reads Connected. */
+const merchants = [
+  { id: 'amazon', name: 'Amazon', press: [0.08, 0.095] },
+  { id: 'uniqlo', name: 'UNIQLO', press: [0.1, 0.115] },
+  { id: 'deliveroo', name: 'Deliveroo', press: [0.12, 0.135] },
+  { id: 'harrods', name: 'Harrods', press: [0.14, 0.155] },
+] as const;
+
+const agents = [
+  { name: 'Matcher', does: 'Matches the £2,160.00 credit to', ref: 'PO-0001-01' },
+  { name: 'Detective', does: 'Flags £3,450.00 moving between your banks' },
+  { name: 'Challenger', does: 'Traces it to a Harrods refund' },
+  { name: 'Curator', does: 'Picks 3 records for NatWest' },
+];
+
+const shared = [
+  { on: 0.78, text: 'Amazon payout', ref: 'PO-0001-01' },
+  { on: 0.79, text: 'NatWest credit', ref: 'txn-0001-004' },
+  { on: 0.8, text: 'The match, checked in code' },
+];
+
+const checks = ['refs', 'dates', 'pennies'];
+const intro = STAGES[0]!;
+const pkg = FLOWS.find((f) => f.id === 'package')!;
+---
+
+<section id="core" class="stream" aria-labelledby="stream-title" data-stream data-stage="0">
+  <div class="stage">
+    <div class="head">
+      <h1 id="stream-title">Your financial passport</h1>
+      <div class="slot">
+        <div class="intro">
+          <p class="lede">{product.tagline}</p>
+          <p class="actions">
+            <Show when="signed-out">
+              <a class="s-btn s-btn--primary" href="/sign-up/">
+                Join
+              </a>
+            </Show>
+            <Show when="signed-in">
+              <a class="s-btn s-btn--primary" href="/app/">
+                Open your passport
+              </a>
+            </Show>
+            <a class="s-btn s-btn--ghost" href="/simulate/">
+              Simulate a case
+            </a>
+          </p>
+        </div>
+        <div class="captions" aria-hidden="true">
+          {STAGES.slice(1).map((s) => (
+            <p class="caption" data-on={s.from} data-off={s.to}>
+              {s.caption}
+            </p>
+          ))}
+        </div>
+      </div>
+      <div class="progress" aria-hidden="true">
+        <span class="bar" data-bar></span>
+        {STAGES.slice(1).map((s) => (
+          <span class="tick" style={`left:${s.from * 100}%`}></span>
+        ))}
+      </div>
+    </div>
+
+    <div class="sr-only">
+      <p>How Alibi answers a bank, as an illustrative example with synthetic data:</p>
+      <ol>
+        <li>
+          Amazon, UNIQLO, Deliveroo and Harrods connect to your Alibi and send signed records,
+          including Amazon payout PO-0001-01 of £2,160.00.
+        </li>
+        <li>
+          Your Santander and NatWest accounts stream in. £3,450.00 moves from Santander to NatWest,
+          which could look like a mule pattern.
+        </li>
+        <li>
+          Four agents investigate. The Matcher matches NatWest credit txn-0001-004 to the payout,
+          the Detective flags the £3,450.00 move, the Challenger traces it to a Harrods refund
+          between your own accounts, and the Curator picks three records. Code checks every
+          reference, date and penny.
+        </li>
+        <li>
+          NatWest’s fraud desk presses “Request customer’s Alibi” and asks about the £2,160.00
+          credit, request rfc-0001-01.
+        </li>
+        <li>
+          You review the answer: the payout, the credit and the match would be shared, and UNIQLO,
+          Deliveroo and Harrods stay private. You approve it for NatWest only.
+        </li>
+        <li>
+          A signed context package reaches NatWest’s fraud desk, and its signature checks out.
+        </li>
+      </ol>
+    </div>
+
+    <div class="board" data-board>
+      <svg class="wires" aria-hidden="true" focusable="false" data-wires>
+        {FLOWS.map((f) => (
+          <path class={`wire wire--${f.id}`} data-wire={f.id} />
+        ))}
+      </svg>
+
+      <ul class="merchants" aria-label="Merchants">
+        {merchants.map((m) => (
+          <li class={`tile tile--${m.id}`} data-node={m.id}>
+            <span class="tile-name">{m.name}</span>
+            <span class="tile-state" data-on={m.press[1]}>
+              <span aria-hidden="true">✓</span> Connected
+            </span>
+            <span class="tile-btn" data-press={`${m.press[0]} ${m.press[1]}`}>
+              <ConnectAlibiButton
+                alibiOrigin={origin}
+                merchantId={m.id}
+                returnTo={returnTo}
+                context="account"
+              />
+            </span>
+          </li>
+        ))}
+      </ul>
+
+      <div class="engine" data-node="engine">
+        <p class="engine-head">
+          <span class="engine-name">
+            <Logomark height="1.05em" />
+            engine
+          </span>
+          <code class="engine-req s-ref" data-on="0.71">
+            rfc-0001-01
+          </code>
+          <span class="engine-count">
+            <span data-count>6</span> records
+          </span>
+        </p>
+        <ol class="agents" aria-label="Agents">
+          {agents.map((a, i) => (
+            <li class="agent" data-agent={i}>
+              <span class="agent-dot" aria-hidden="true"></span>
+              <span class="agent-name">{a.name}</span>
+              <span class="agent-does">
+                {a.does} {a.ref && <code class="s-ref">{a.ref}</code>}
+              </span>
+            </li>
+          ))}
+        </ol>
+        <p class="engine-foot">
+          <span class="foot-label">Code decides</span>
+          <span class="checks">
+            {checks.map((c, i) => (
+              <span>
+                <span class="check-mark" data-on={0.6 + i * 0.005} aria-hidden="true">
+                  ✓
+                </span>
+                {c}
+              </span>
+            ))}
+          </span>
+        </p>
+      </div>
+
+      <div class="banks">
+        <div class="bank bank--santander" data-node="santander">
+          <p class="bank-band">
+            <span class="bank-name">Santander</span>
+            <span class="bank-acct">Current account</span>
+          </p>
+          <ul class="ledger">
+            <li data-on="0.3">
+              <span>Harrods refund</span>
+              <span class="amt">+£3,450.00</span>
+            </li>
+            <li data-on="0.36">
+              <span>To NatWest</span>
+              <span class="amt amt--out">−£3,450.00</span>
+            </li>
+          </ul>
+        </div>
+        <div class="bank bank--natwest" data-node="natwest">
+          <p class="bank-band">
+            <span class="bank-name">NatWest</span>
+            <span class="bank-acct">Current account</span>
+          </p>
+          <ul class="ledger">
+            <li data-on="0.31">
+              <span>Amazon payout</span>
+              <span class="amt">+£2,160.00</span>
+            </li>
+            <li data-on="0.45">
+              <span>From Santander</span>
+              <span class="amt">+£3,450.00</span>
+            </li>
+          </ul>
+        </div>
+      </div>
+
+      <div class="consent" data-node="consent">
+        <p class="consent-head">
+          <span class="consent-title">Your review</span>
+          <span class="consent-meta">Shared with NatWest only</span>
+        </p>
+        <div class="consent-body">
+          <p class="consent-wait" data-off="0.78">
+            Nothing leaves without you
+          </p>
+          <ul class="consent-list">
+            {shared.map((r) => (
+              <li class="yes" data-on={r.on}>
+                <span class="mark" aria-hidden="true">
+                  ✓
+                </span>
+                <span>
+                  <span class="sr-only">Shared: </span>
+                  {r.text} {r.ref && <code class="s-ref">{r.ref}</code>}
+                </span>
+              </li>
+            ))}
+            <li class="no" data-on="0.81">
+              <span class="mark" aria-hidden="true">
+                ✕
+              </span>
+              <span>UNIQLO, Deliveroo and Harrods stay private</span>
+            </li>
+          </ul>
+        </div>
+        <p class="approve" data-press="0.825 0.84">
+          <span class="approve-ok" data-on="0.84" aria-hidden="true"></span>
+          <span class="approve-label" data-off="0.84">
+            Approve for NatWest
+          </span>
+          <span class="approve-label" data-on="0.84">
+            Approved <span aria-hidden="true">✓</span>
+          </span>
+        </p>
+      </div>
+
+      <div class="desk" data-node="desk">
+        <p class="desk-band">
+          <span class="desk-name">NatWest</span>
+          <span class="desk-unit">Fraud desk</span>
+        </p>
+        <div class="desk-body">
+          <p class="desk-case">
+            <code class="s-ref">FC-0147</code> £2,160.00 credit under review
+          </p>
+          <span class="desk-btn" data-press="0.62 0.64">
+            <RequestAlibiButton href="/simulate/" />
+          </span>
+          <ul class="desk-log">
+            <li data-on="0.64">
+              Asked <code class="s-ref">rfc-0001-01</code>
+            </li>
+            <li class="dock">
+              <span class="stamp stamp--package dock-chip" data-dock>
+                {pkg.label}
+              </span>
+            </li>
+            <li data-on="0.96">
+              <span class="ok" aria-hidden="true">
+                ✓
+              </span>{' '}
+              Signature valid
+            </li>
+            <li data-on="0.96">Approved by Maya for NatWest only</li>
+          </ul>
+        </div>
+      </div>
+
+      <div class="packets" aria-hidden="true">
+        {FLOWS.map((f) => (
+          <span class={`packet stamp stamp--${f.id}`} data-packet={f.id}>
+            <span class="long">{f.label}</span>
+            <span class="short">{f.short}</span>
+          </span>
+        ))}
+      </div>
+      <p class="badge" data-badge aria-hidden="true">
+        <span class="badge-q" data-on={MULE.flagged} data-off={MULE.cleared}>
+          Mule pattern?
+        </span>
+        <span class="badge-ok" data-on={MULE.cleared}>
+          Cleared: own accounts, traced to a Harrods refund ✓
+        </span>
+      </p>
+    </div>
+
+    <div class="foot">
+      <p>Illustrative · not affiliated · synthetic data</p>
+      <p class="hint" data-off={intro.to} aria-hidden="true">
+        {intro.caption}
+      </p>
+    </div>
+  </div>
+</section>
+
+<script>
+  import {
+    FLOWS,
+    MULE,
+    STAGES,
+    agentsLit,
+    anchorPoint,
+    clamp01,
+    isOn,
+    packetState,
+    progressOf,
+    recordsIn,
+    stageIndex,
+    windowProgress,
+    wirePath,
+    type Box,
+    type Flow,
+    type Point,
+  } from '@/lib/stream';
+
+  /** Must match the CSS: scrubbing needs scripting and motion; the narrow board is one column. */
+  const SCRUB = '(scripting: enabled) and (prefers-reduced-motion: no-preference)';
+  const NARROW = '(max-width: 860px)';
+  /** Packets fade in and out over this share of their trip. */
+  const FADE = 0.08;
+
+  interface Wire {
+    flow: Flow;
+    path: SVGPathElement;
+    packet: HTMLElement;
+    len: number;
+    w: number;
+    h: number;
+  }
+
+  const num = (v: string | undefined) => (v === undefined || v === '' ? undefined : Number(v));
+  const smooth = (x: number) => x * x * (3 - 2 * x);
+
+  function setup(root: HTMLElement) {
+    const found = root.querySelector<HTMLElement>('[data-board]');
+    if (!found) return;
+    const board: HTMLElement = found;
+
+    const nodes = new Map<string, HTMLElement>();
+    root.querySelectorAll<HTMLElement>('[data-node]').forEach((el) => {
+      if (el.dataset.node) nodes.set(el.dataset.node, el);
+    });
+    const gated = Array.from(root.querySelectorAll<HTMLElement>('[data-on], [data-off]'), (el) => ({
+      el,
+      on: num(el.dataset.on),
+      off: num(el.dataset.off),
+    }));
+    const presses = Array.from(root.querySelectorAll<HTMLElement>('[data-press]'), (el) => {
+      const [on, off] = (el.dataset.press ?? '').split(' ').map(Number);
+      return { el, on, off };
+    });
+    const agents = Array.from(root.querySelectorAll<HTMLElement>('[data-agent]'));
+    const bar = root.querySelector<HTMLElement>('[data-bar]');
+    const count = root.querySelector<HTMLElement>('[data-count]');
+    const badge = root.querySelector<HTMLElement>('[data-badge]');
+    const dock = root.querySelector<HTMLElement>('[data-dock]');
+    const wires: Wire[] = [];
+    for (const flow of FLOWS) {
+      const path = root.querySelector<SVGPathElement>(`[data-wire="${flow.id}"]`);
+      const packet = root.querySelector<HTMLElement>(`[data-packet="${flow.id}"]`);
+      if (path && packet) wires.push({ flow, path, packet, len: 0, w: 0, h: 0 });
+    }
+    const mule = wires.find((w) => w.flow.id === 'mule');
+    const engine = STAGES.find((s) => s.id === 'engine')!;
+
+    const scrub = window.matchMedia(SCRUB);
+    const narrow = window.matchMedia(NARROW);
+    let width = 0;
+    let height = 0;
+    let dockAt: Point | null = null;
+    let laidOut = false;
+    let lastP = -1;
+    let visible = true;
+    let frame = false;
+    let pendingLayout = false;
+    let pendingFit = false;
+
+    const boxOf = (el: Element, origin: DOMRect): Box => {
+      const r = el.getBoundingClientRect();
+      return { x: r.left - origin.left, y: r.top - origin.top, w: r.width, h: r.height };
+    };
+
+    /** Shrinks the board's type until every node fits the sticky stage (odd viewports). */
+    function fit() {
+      board.style.fontSize = '';
+      if (!scrub.matches) return;
+      const cs = getComputedStyle(board);
+      const pad = parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom);
+      for (let i = 0; i < 2; i++) {
+        const origin = board.getBoundingClientRect();
+        let top = Infinity;
+        let bottom = -Infinity;
+        for (const el of nodes.values()) {
+          const b = boxOf(el, origin);
+          top = Math.min(top, b.y);
+          bottom = Math.max(bottom, b.y + b.h);
+        }
+        const need = bottom - top + pad;
+        const have = board.clientHeight;
+        if (need <= have + 1) return;
+        const size = parseFloat(getComputedStyle(board).fontSize);
+        board.style.fontSize = `${Math.max(7, (size * have) / need).toFixed(2)}px`;
+      }
+    }
+
+    /** Recomputes every wire from the nodes' rectangles. Runs on resize only, never per frame. */
+    function layout() {
+      const origin = board.getBoundingClientRect();
+      width = origin.width;
+      height = origin.height;
+      const em = parseFloat(getComputedStyle(board).fontSize);
+      const isNarrow = narrow.matches;
+      for (const w of wires) {
+        const [a, b] = isNarrow ? w.flow.narrow : w.flow.wide;
+        const from = nodes.get(a.node);
+        const to = nodes.get(b.node);
+        if (!from || !to) continue;
+        const pa = anchorPoint(boxOf(from, origin), a.side, a.at);
+        const pb = anchorPoint(boxOf(to, origin), b.side, b.at);
+        const reach = w.flow.reach[isNarrow ? 1 : 0] * em;
+        w.path.setAttribute('d', wirePath(pa, a.side, pb, b.side, reach));
+        w.len = w.path.getTotalLength();
+        w.path.style.strokeDasharray = `${w.len} ${w.len}`;
+        w.w = w.packet.offsetWidth;
+        w.h = w.packet.offsetHeight;
+      }
+      if (dock) {
+        const d = boxOf(dock, origin);
+        dockAt = { x: d.x + d.w / 2, y: d.y + d.h / 2 };
+      }
+      if (badge && mule && mule.len > 0) {
+        const mid = mule.path.getPointAtLength(mule.len / 2);
+        badge.style.left = `${mid.x.toFixed(1)}px`;
+        badge.style.top = `${mid.y.toFixed(1)}px`;
+        badge.classList.add('is-placed');
+      }
+      root.classList.add('has-js');
+      laidOut = true;
+      lastP = -1;
+      render();
+    }
+
+    function progress(): number {
+      if (!scrub.matches) return 1;
+      const r = root.getBoundingClientRect();
+      return progressOf(r.top, root.offsetHeight, window.innerHeight);
+    }
+
+    function render() {
+      if (!laidOut) return;
+      const p = progress();
+      if (p === lastP) return;
+      lastP = p;
+
+      root.dataset.stage = String(stageIndex(p));
+      for (const g of gated) g.el.classList.toggle('is-on', isOn(p, g.on, g.off));
+      for (const g of presses) g.el.classList.toggle('is-pressed', isOn(p, g.on, g.off));
+
+      const lit = agentsLit(p, agents.length);
+      const working = p >= engine.from && p < engine.to;
+      agents.forEach((el, i) => {
+        el.classList.toggle('is-lit', i < lit);
+        el.classList.toggle('is-active', working && i === lit - 1);
+      });
+      if (bar) bar.style.transform = `scaleX(${p.toFixed(4)})`;
+      if (count) count.textContent = String(recordsIn(p));
+
+      for (const w of wires) {
+        const drawn = windowProgress(p, w.flow.draw);
+        w.path.style.strokeDashoffset = String(w.len * (1 - drawn));
+        w.path.style.opacity = drawn > 0 ? '1' : '0';
+
+        const s = packetState(p, w.flow.packet);
+        w.path.classList.toggle('is-hot', s.visible && s.t < 1);
+        if (!s.visible || w.len === 0) {
+          w.packet.style.opacity = '0';
+          continue;
+        }
+        const pt = w.path.getPointAtLength(s.t * w.len);
+        let x = pt.x;
+        let y = pt.y;
+        if (w.flow.dock && dockAt) {
+          // The final package leaves the wire for its slot in the desk's log.
+          const k = smooth(clamp01((s.t - 0.75) / 0.25));
+          x += (dockAt.x - x) * k;
+          y += (dockAt.y - y) * k;
+        }
+        const along = windowProgress(p, [w.flow.packet.from, w.flow.packet.to]);
+        const fade = w.flow.packet.hold
+          ? Math.min(1, along / FADE)
+          : Math.min(1, along / FADE, (1 - along) / FADE);
+        // Keep packets on the board: wires that run along its edges stay inside it.
+        x = Math.min(Math.max(x - w.w / 2, 0), Math.max(0, width - w.w));
+        y = Math.min(Math.max(y - w.h / 2, 0), Math.max(0, height - w.h));
+        w.packet.style.opacity = fade.toFixed(3);
+        w.packet.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`;
+      }
+
+      if (mule) {
+        mule.path.classList.toggle('is-flag', isOn(p, MULE.flagged, MULE.cleared));
+        mule.path.classList.toggle('is-clear', p >= MULE.cleared);
+      }
+    }
+
+    function schedule() {
+      if (frame) return;
+      frame = true;
+      requestAnimationFrame(() => {
+        frame = false;
+        render();
+      });
+    }
+
+    function queueLayout(refit = false) {
+      pendingFit ||= refit;
+      if (pendingLayout) return;
+      pendingLayout = true;
+      requestAnimationFrame(() => {
+        pendingLayout = false;
+        if (pendingFit) {
+          pendingFit = false;
+          fit();
+        }
+        layout();
+      });
+    }
