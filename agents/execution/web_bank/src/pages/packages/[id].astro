---
/**
 * One received Alibi package, as Bank A's analyst sees it. Reads `/bank/bank_a/packages/<id>` from
 * the backend as JSON with the bank's credential, or the built-in case 1 preview. Another bank's
 * package ID gets the backend's 404, shown as "not found" with no hint it exists (SP-18).
 */
import { ALIBI_API_ORIGIN, BANK_A_TOKEN } from 'astro:env/server';

import { loadContext } from '@alibi/ui/api';
import ConsoleLayout from '@/layouts/ConsoleLayout.astro';
import Decision from '@/components/Decision.astro';
import Evidence from '@/components/Evidence.astro';
import Verification from '@/components/Verification.astro';
import { packageFixture } from '@/data/analyst';
import { ROUTES, backendHeaders, isPackage, takeFlash } from '@/lib/screens';
import { showsEvidence } from '@/lib/view';

export const prerender = false;

const id = Astro.params.id ?? '';
const loaded = await loadContext({
  origin: ALIBI_API_ORIGIN,
  path: ROUTES.package(id),
  isShape: isPackage,
  fixture: () => packageFixture(id),
  headers: backendHeaders(BANK_A_TOKEN),
});
const flash = takeFlash(Astro.cookies);
Astro.response.headers.set('Cache-Control', 'private, no-store');
if (loaded.source === 'missing') Astro.response.status = 404;
const returnTo = `/packages/${encodeURIComponent(id)}/`;
---

<ConsoleLayout title={`Package ${id}`}>
  <p>
    <a href="/inbox/">← Alibi inbox</a>
  </p>
  {loaded.source === 'missing' ? (
    <>
      <h1>Package not found</h1>
      <p>No package with that ID is available to this bank.</p>
    </>
  ) : (
    <>
      <h1>
        Package <code>{loaded.data.package.package_id}</code>
      </h1>
      {loaded.source === 'fixture' && (
        <p class="note" role="note">
          Built-in case 1 preview, not live data. {loaded.reason}
        </p>
      )}
      {flash && (
        <div class={`flash flash--${flash.kind}`} role="status">
          {flash.kind === 'refused' && (
            <>
              <strong>Refused by the backend</strong> <code>{flash.refusal.code}</code>
              <pre>{flash.refusal.reason}</pre>
            </>
          )}
          {flash.kind === 'unavailable' && <p>{flash.message}</p>}
          {flash.kind === 'ok' && <p>{flash.message}</p>}
        </div>
      )}

      <dl class="summary">
        <dt>Request</dt>
        <dd>
          <code>{loaded.data.package.request_id}</code>
        </dd>
        <dt>Customer</dt>
        <dd>
          <code>{loaded.data.package.subject_ref_masked}</code>
        </dd>
        <dt>Scope</dt>
        <dd>
          {(loaded.data.package.txn_ids ?? []).length > 0 ? (
            (loaded.data.package.txn_ids ?? []).map((t) => <code>{t}</code>)
          ) : loaded.data.package.period ? (
            <>
              <code>{loaded.data.package.period.from}</code> to <code>{loaded.data.package.period.to}</code>
            </>
          ) : (
            '—'
          )}
        </dd>
        <dt>Expires</dt>
        <dd>
          <code>{loaded.data.package.expires_at}</code>
        </dd>
      </dl>

      <Verification pkg={loaded.data} />
      {showsEvidence(loaded.data) && (
        <>
          <Evidence pkg={loaded.data} />
          <Decision pkg={loaded.data} returnTo={returnTo} />
        </>
      )}
    </>
  )}
</ConsoleLayout>

<style>
  h1 {
    font-size: var(--t-lg);
  }
  .note {
    padding: var(--space-xs) var(--space-sm);
    border: 1px dashed var(--c-line);
    background: var(--c-surface);
  }
  .summary {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-3xs) var(--space-sm);
  }
  .summary dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
  .flash {
    border: 2px solid var(--c-ink);
    background: var(--c-surface);
    padding: var(--space-sm);
    margin-block: var(--space-sm);
  }
  .flash--refused {
    border-color: var(--c-bad);
  }
  .flash pre {
    white-space: pre-wrap;
    font-family: var(--font-mono);
  }
</style>
