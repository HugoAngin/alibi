diff --git a/alibi/app/templates/partials/when.html b/alibi/app/templates/partials/when.html
new file mode 100644
index 0000000..379d8d6
--- /dev/null
+++ b/alibi/app/templates/partials/when.html
@@ -0,0 +1,12 @@
+{#
+  Timestamp macro. Import with:
+    {% from "partials/when.html" import when %}
+
+  when(ts) takes a UTC ISO-8601 string and prints it inside
+  <time class="when" datetime="..."> so the stylesheet and scripts can find
+  every timestamp. A falsy value (None or "") prints an em dash in .muted.
+#}
+
+{% macro when(ts) -%}
+{%- if ts %}<time class="when" datetime="{{ ts }}">{{ ts }}</time>{% else %}<span class="muted">—</span>{% endif -%}
+{%- endmacro %}
