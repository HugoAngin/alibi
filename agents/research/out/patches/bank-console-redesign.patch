diff --git a/web/apps/bank/src/lib/caseState.ts b/web/apps/bank/src/lib/caseState.ts
new file mode 100644
index 0000000..4b77e30
--- /dev/null
+++ b/web/apps/bank/src/lib/caseState.ts
@@ -0,0 +1,43 @@
+/**
+ * Where each case stands with Alibi, from the bank service's own inbox: nothing asked yet, a
+ * request waiting for the customer, or a package received. Without a live inbox (the built-in
+ * preview) nothing has been sent, so every case starts at "not requested" and the full request
+ * flow stays visible.
+ */
+import type { FraudCase } from '../data/cases';
+
+import type { AnalystInbox } from './types';
+
+export type AlibiState =
+  | { kind: 'unavailable' }
+  | { kind: 'closed' }
+  | { kind: 'not_requested' }
+  | { kind: 'requested'; requestId: string; sentAt: string }
+  | { kind: 'received'; requestId: string; packageId: string; href: string; receivedAt: string };
+
+export function alibiState(c: FraudCase, inbox: AnalystInbox | null): AlibiState {
+  if (c.status === 'closed') return { kind: 'closed' };
+  if (!c.request) return { kind: 'unavailable' };
+  const id = c.request.id;
+  const pkg = inbox?.packages.find((p) => p.request_id === id);
+  if (pkg)
+    return {
+      kind: 'received',
+      requestId: id,
+      packageId: pkg.package_id,
+      href: pkg.href,
+      receivedAt: pkg.received_at,
+    };
+  const sent = inbox?.requests_sent.find((r) => r.request_id === id);
+  if (sent) return { kind: 'requested', requestId: id, sentAt: sent.sent_at };
+  return { kind: 'not_requested' };
+}
+
+/** The status column's words; never colour alone. */
+export function statusLabel(c: FraudCase, s: AlibiState): string {
+  if (s.kind === 'received') return 'Alibi received';
+  if (s.kind === 'requested') return 'Awaiting customer';
+  if (c.status === 'awaiting_customer') return 'Awaiting customer';
+  if (c.status === 'closed') return 'Closed';
+  return 'Open';
+}
diff --git a/web/apps/bank/src/lib/queue.ts b/web/apps/bank/src/lib/queue.ts
new file mode 100644
index 0000000..f384ce5
--- /dev/null
+++ b/web/apps/bank/src/lib/queue.ts
@@ -0,0 +1,61 @@
+/**
+ * What the case queue pages (/, /cases/<id>/, /cases/<id>/request/) need from the server: the
+ * analyst's session, each case's Alibi state from the bank service's live inbox, and a one-off
+ * flash from the last action. Without a configured bank service the queue is the built-in
+ * preview: every case starts at "not requested" and sending is off.
+ */
+import type { AstroCookies } from 'astro';
+import {
+  ALIBI_API_ORIGIN,
+  BANK_API_ORIGIN,
+  BANK_A_TOKEN,
+  BANK_SESSION_SECRET,
+} from 'astro:env/server';
+
+import { analyst as demoAnalyst, bank, cases } from '@/data/cases';
+
+import { bankTarget } from './bankApi';
+import { alibiState, type AlibiState } from './caseState';
+import { loadInbox } from './load';
+import { RECIPIENT, backendHeaders, takeFlash, type Flash } from './screens';
+import { SESSION_COOKIE, verifySession } from './session';
+
+export interface Queue {
+  /** True when the bank service answered; false in the preview. */
+  live: boolean;
+  /** Why the queue is a preview, when it is. */
+  previewReason: string | null;
+  states: Record<string, AlibiState>;
+  flash: Flash | null;
+}
+
+export type QueueLoad = { redirect: string } | { queue: Queue };
+
+export async function loadQueue(cookies: AstroCookies): Promise<QueueLoad> {
+  const analyst = await verifySession(
+    BANK_SESSION_SECRET,
+    cookies.get(SESSION_COOKIE)?.value,
+    Date.now(),
+  );
+  const target = bankTarget(BANK_API_ORIGIN, ALIBI_API_ORIGIN);
+  if (target.origin && !analyst) return { redirect: '/sign-in/' };
+
+  const who = { id: RECIPIENT, name: bank.name, analyst_name: analyst ?? demoAnalyst.name };
+  const loaded = target.origin
+    ? await loadInbox(target, who, backendHeaders(BANK_A_TOKEN))
+    : { source: 'fixture' as const, reason: 'The bank service is not connected here.' };
+  const live = loaded.source === 'live';
+  const inbox = loaded.source === 'live' ? loaded.data : null;
+
+  const states: Record<string, AlibiState> = {};
+  for (const c of cases) states[c.id] = alibiState(c, inbox);
+
+  return {
+    queue: {
+      live,
+      previewReason: live ? null : (('reason' in loaded ? loaded.reason : null) ?? null),
+      states,
+      flash: takeFlash(cookies),
+    },
+  };
+}
