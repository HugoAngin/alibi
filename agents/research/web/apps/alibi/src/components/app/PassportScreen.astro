---
/** Home screen: the proactive alert, the credit in question and how it adds up. */
import { alert, breakdown, connections, credit, formatGBP, netMinor } from '@/data/demo';

const lines = [
  { label: 'Sales', sign: '+', minor: breakdown.salesMinor },
  { label: 'Refunds', sign: '−', minor: breakdown.refundsMinor },
  { label: 'Fees', sign: '−', minor: breakdown.feesMinor },
];
const matches = netMinor() === credit.amountMinor;
---

<section id="passport" class="screen" aria-labelledby="passport-title">
  <h1 id="passport-title">Your passport</h1>

  <article class="card alert" aria-label="Alert">
    <p class="label">Alert · before any request</p>
    <h2>{alert.title}</h2>
    <p>{alert.body}</p>
  </article>

  <article class="card" aria-labelledby="credit-title">
    <p class="label">Credit · {credit.bookedAt.slice(0, 10)}</p>
    <h2 id="credit-title">{formatGBP(credit.amountMinor)} from ResaleHub</h2>
    <p class="ref">
      <code>{credit.txnId}</code> · ref <code>{credit.payoutReference}</code>
    </p>
    <table aria-label="How this credit adds up">
      <tbody>
        {lines.map((l) => (
          <tr>
            <th scope="row">{l.label}</th>
            <td class="num">
              {l.sign} {formatGBP(l.minor)}
            </td>
          </tr>
        ))}
        <tr class="total">
          <th scope="row">Net</th>
          <td class="num">{formatGBP(netMinor())}</td>
        </tr>
      </tbody>
    </table>
    <p class="note">{matches ? 'Adds up to the credit.' : 'Does not add up to the credit.'}</p>
  </article>

  <article class="card" aria-labelledby="connections-title">
    <h2 id="connections-title">Connections</h2>
    <ul class="plain">
      {connections.map((c) => (
        <li>
          <strong>{c.name}</strong> · {c.kind} · <span class="label">{c.trust}</span>
        </li>
      ))}
    </ul>
  </article>
</section>

<style>
  h1 {
    font-size: var(--t-lg);
  }

  .card {
    margin-block: var(--space-sm);
    padding: var(--space-sm);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-md);
  }

  .card h2 {
    font-size: var(--t-md);
  }

  .alert {
    border-left: 4px solid var(--c-warn);
  }

  .label {
    font-size: var(--t-xs);
    color: var(--c-ink-faint);
    margin-bottom: var(--space-3xs);
  }

  .ref,
  .note {
    font-size: var(--t-sm);
    color: var(--c-ink-soft);
  }

  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .total th,
  .total td {
    font-weight: 700;
    border-bottom: 0;
  }

  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--t-sm);
  }
</style>
