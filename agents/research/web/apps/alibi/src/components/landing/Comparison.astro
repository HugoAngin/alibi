---
import { differentiation } from '@/data/product';
---

<section id="why" class="why" aria-labelledby="why-title">
  <h2 id="why-title">Why Alibi</h2>
  <table>
    <thead>
      <tr>
        <th scope="col">Today</th>
        <th scope="col">With Alibi</th>
      </tr>
    </thead>
    <tbody>
      {differentiation.map((row) => (
        <tr>
          <td>{row.today}</td>
          <td>{row.alibi}</td>
        </tr>
      ))}
    </tbody>
  </table>
</section>

<style>
  .why {
    padding-block: var(--space-xl);
    max-width: var(--measure);
  }

  th {
    font-size: var(--t-sm);
    color: var(--c-ink-faint);
  }

  td:first-child {
    color: var(--c-ink-soft);
  }

  td:last-child {
    font-weight: 600;
  }
</style>
