{
  "type": "object",
  "description": "Detective output: observable alerts and one candidate claim per stated question.",
  "properties": {
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "unexplained_credit",
              "unusual_inflow",
              "unusual_outflow",
              "amount_discrepancy",
              "settlement_discrepancy",
              "merchant_unverified"
            ]
          },
          "summary": {"type": "string", "maxLength": 300},
          "refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "record_id": {"type": "string"},
                "revision": {"type": "integer", "minimum": 1}
              },
              "required": ["record_id", "revision"],
              "additionalProperties": false
            }
          },
          "suggested_evidence": {"type": "string", "maxLength": 300}
        },
        "required": ["kind", "summary", "refs", "suggested_evidence"],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {"type": "string"},
          "question_id": {"type": "string"},
          "statement": {"type": "string", "maxLength": 400},
          "status": {"type": "string", "enum": ["supported", "unresolved", "contradicted"]},
          "refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "record_id": {"type": "string"},
                "revision": {"type": "integer", "minimum": 1},
                "role": {"type": "string", "enum": ["confirms", "conflicts", "context"]}
              },
              "required": ["record_id", "revision", "role"],
              "additionalProperties": false
            }
          },
          "gaps": {
            "type": "array",
            "items": {"type": "string", "maxLength": 300}
          },
          "next_checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "lookup_settlement",
                    "lookup_payouts_covering",
                    "lookup_by_date",
                    "refresh_txn",
                    "merchant_lookup",
                    "none"
                  ]
                },
                "args": {
                  "type": "object",
                  "description": "Only the keys the check needs: lookup_settlement {payout_reference, merchant_id?}; lookup_payouts_covering {record_id}; lookup_by_date {payout_date YYYY-MM-DD}; refresh_txn {txn_id}; merchant_lookup {merchant_id}; none {}.",
                  "properties": {
                    "payout_reference": {"type": "string"},
                    "txn_id": {"type": "string"},
                    "merchant_id": {"type": "string"},
                    "record_id": {"type": "string"},
                    "payout_date": {"type": "string", "description": "YYYY-MM-DD"}
                  },
                  "additionalProperties": false
                },
                "reason": {"type": "string", "maxLength": 300}
              },
              "required": ["type", "args", "reason"],
              "additionalProperties": false
            }
          }
        },
        "required": ["claim_id", "question_id", "statement", "status", "refs", "gaps", "next_checks"],
        "additionalProperties": false
      }
    }
  },
  "required": ["alerts", "claims"],
  "additionalProperties": false
}
