{
  "type": "object",
  "description": "One-pass baseline output: every claim and every disclosure proposed in a single call.",
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {"type": "string"},
          "statement": {"type": "string", "maxLength": 600},
          "status": {"type": "string", "enum": ["supported", "contradicted", "unresolved"]},
          "refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "record_id": {"type": "string"},
                "revision": {"type": "integer", "minimum": 1},
                "role": {"type": "string", "enum": ["confirms", "conflicts", "context"]}
              },
              "required": ["record_id", "revision", "role"],
              "additionalProperties": false
            }
          },
          "gaps": {
            "type": "array",
            "items": {"type": "string", "maxLength": 300}
          }
        },
        "required": ["question_id", "statement", "status", "refs", "gaps"],
        "additionalProperties": false
      }
    },
    "disclosures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {"type": "string"},
          "record_id": {"type": "string"},
          "revision": {"type": "integer", "minimum": 1},
          "form": {
            "type": "string",
            "enum": ["full", "extract", "generalised"],
            "description": "full = whole record; extract = only the fields named in 'fields'; generalised = a category or total without identifying detail."
          },
          "fields": {
            "type": "array",
            "items": {"type": "string"}
          },
          "reason": {"type": "string", "maxLength": 200}
        },
        "required": ["question_id", "record_id", "revision", "form", "fields", "reason"],
        "additionalProperties": false
      }
    },
    "rationale": {"type": "string", "maxLength": 600}
  },
  "required": ["claims", "disclosures", "rationale"],
  "additionalProperties": false
}
