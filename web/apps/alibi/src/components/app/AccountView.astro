---
/**
 * The Account screen, for `/app/account/` (the signed-in holder) and `/simulate/account/` (Maya's,
 * shown to a visitor read-only, or acted as by the presenter in the live demo). Who is signed in
 * (Clerk), the holder's financial passport, exporting their data, and the way back to the website.
 * In the simulation there is nobody to sign in or out and no export; links stay in the simulation
 * (src/lib/simulation.ts).
 */
import { ALIBI_SIMULATE_ACTIONS } from 'astro:env/server';
import { SignOutButton } from '@clerk/astro/components';

import BaseLayout from '@/layouts/BaseLayout.astro';
import AppFrame from '@/components/app/AppFrame.astro';
import PassportShowcase from '@/components/app/PassportShowcase.astro';
import { loadPassport } from '@/lib/passport';

interface Props {
  /** `/simulate/account/`: Maya's account, read-only, for any visitor. */
  simulation?: boolean;
}

const { simulation = false } = Astro.props;
// The live demo (ALIBI_SIMULATE_ACTIONS=1): the presenter acts as Maya, so it is not read-only.
const liveDemo = simulation && ALIBI_SIMULATE_ACTIONS === '1';
const loaded = await loadPassport();
Astro.response.headers.set('Cache-Control', 'private, no-store');

// Local demo (demo holder mode, src/middleware.ts): no Clerk at all, a signed Maya session instead.
const demo = !simulation && Astro.locals.demoHolder !== undefined;
let user: Awaited<ReturnType<typeof Astro.locals.currentUser>> = null;
if (!demo && !simulation) {
  try {
    user = (await Astro.locals.currentUser?.()) ?? null;
  } catch {
    user = null;
  }
}

const holder = loaded.source === 'missing' ? 'Maya' : loaded.data.holder.name;
const name = user?.fullName || user?.username || holder;
const email = user?.primaryEmailAddress?.emailAddress ?? null;
const sub = simulation
  ? liveDemo
    ? 'Live demo · acting as Maya'
    : 'Simulation · read-only'
  : demo
    ? 'Local demo session'
    : (email ?? (user ? 'Signed in' : 'Not signed in'));
const chevron = 'M9 6l6 6-6 6';
---

<BaseLayout title="Account" view="app">
  <AppFrame
    active="account"
    simulation={simulation}
    holder={holder}
    fixtureReason={loaded.source === 'fixture' ? loaded.reason : undefined}
  >
    <section class="profile">
      {user?.imageUrl ? (
        <img class="photo" src={user.imageUrl} alt="" width="64" height="64" />
      ) : (
        <span class="photo photo--letter" aria-hidden="true">
          {name.slice(0, 1).toUpperCase()}
        </span>
      )}
      <h1 class="name">{name}</h1>
      <p class="sub">{sub}</p>
    </section>

    {loaded.source !== 'missing' && (
      <a class="passport" href="/app/account/passport/">
        <PassportShowcase data={loaded.data} />
        <span class="passport-caption">
          {simulation ? `${holder}’s` : 'Your'} financial passport <span aria-hidden="true">→</span>
        </span>
      </a>
    )}

    <section class="group" aria-labelledby="account-title">
      <h2 id="account-title" class="group-title">
        Account
      </h2>
      <ul class="rows">
        {simulation ? (
          <li>
            <a class="row" href="/sign-up/" target="_top">
              <span>
                Start your own alibi
                <small>
                  {liveDemo
                    ? `You’re acting as ${holder} in the live demo`
                    : `This is ${holder}’s account; nothing here can be changed`}
                </small>
              </span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={chevron} />
              </svg>
            </a>
          </li>
        ) : demo ? (
          <li>
            <form method="post" action="/demo-session/?out=1">
              <button class="row row--button" type="submit">
                <span>Sign out</span>
              </button>
            </form>
          </li>
        ) : user ? (
          <>
            <li>
              <a class="row" href="/app/account/profile/">
                <span>Profile and security</span>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d={chevron} />
                </svg>
              </a>
            </li>
            <li>
              <SignOutButton redirectUrl="/">
                <button class="row row--button" type="button">
                  <span>Sign out</span>
                </button>
              </SignOutButton>
            </li>
          </>
        ) : (
          <li>
            <a class="row" href="/sign-in/" target="_top">
              <span>Sign in</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={chevron} />
              </svg>
            </a>
          </li>
        )}
      </ul>
    </section>

    <section class="group" aria-labelledby="data-title">
      <h2 id="data-title" class="group-title">
        Your data
      </h2>
      <ul class="rows">
        <li>
          <a class="row" href="/app/account/passport/">
            <span>
              Financial passport
              <small>
                {simulation
                  ? 'Every package Maya approved and sent, signed'
                  : 'Every package you approved and sent, signed'}
              </small>
            </span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={chevron} />
            </svg>
          </a>
        </li>
        {!simulation && (
          <li>
            <a class="row" href="/app/account/export.json" download>
              <span>
                Export your passport data
                <small>
                  Unsigned JSON of your connections, transactions, alerts, rules, requests and what
                  you shared
                </small>
              </span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 5v10m-4-4 4 4 4-4M6 19h12" />
              </svg>
            </a>
          </li>
        )}
      </ul>
    </section>

    {loaded.source !== 'missing' && (
      <section class="group" aria-labelledby="rules-title">
        <h2 id="rules-title" class="group-title">
          Your privacy rules
        </h2>
        {loaded.data.rules.length === 0 ? (
          <p class="note">
            No rules yet. Alibi still shares only what a question needs, and only after you approve.
          </p>
        ) : (
          <ul class="rows">
            {loaded.data.rules.map((r) => (
              <li class="rule">
                <span>“{r.text}”</span>
                <small>
                  {r.summary} · {r.status}
                </small>
              </li>
            ))}
          </ul>
        )}
      </section>
    )}

    <section class="group" aria-labelledby="about-title">
      <h2 id="about-title" class="group-title">
        About
      </h2>
      <ul class="rows">
        <li>
          <a class="row" href="/?view=site" target="_top">
            <span>View the Alibi website</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={chevron} />
            </svg>
          </a>
        </li>
      </ul>
    </section>
  </AppFrame>
</BaseLayout>

<style>
  .profile {
    display: grid;
    justify-items: center;
    text-align: center;
    padding-block: 18px 8px;
  }

  .photo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 12px;
  }

  .photo--letter {
    display: grid;
    place-items: center;
    background: var(--a-ink);
    color: var(--s-paper);
    font: 600 1.5rem/1 var(--a-display);
  }

  .name {
    margin: 0;
    font: 500 1.5rem/1.15 var(--a-display);
    letter-spacing: -0.02em;
  }

  .sub {
    margin: 4px 0 0;
    font-size: var(--t-sm);
    color: var(--a-faint);
  }

  .passport {
    display: block;
    margin-top: 28px;
    color: inherit;
    text-decoration: none;
  }

  .passport-caption {
    display: block;
    margin-top: 10px;
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--a-accent);
    text-align: center;
  }

  .group {
    margin-top: 34px;
  }

  .group-title {
    margin: 0 0 4px;
    font: 500 0.75rem/1 var(--a-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--a-faint);
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rows li + li {
    border-top: 1px solid var(--a-line);
  }

  .row {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 52px;
    padding-block: 10px;
    color: inherit;
    text-decoration: none;
    font: 500 1rem/1.3 var(--a-body);
    text-align: left;
  }

  .row--button {
    border: 0;
    background: none;
    cursor: pointer;
    padding-inline: 0;
    color: var(--a-bad);
  }

  .row small {
    display: block;
    margin-top: 2px;
    font-size: var(--t-xs);
    font-weight: 400;
    color: var(--a-faint);
  }

  .row svg {
    flex: none;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--a-faint);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .rule {
    display: grid;
    gap: 2px;
    padding-block: 12px;
  }

  .rule small {
    font-size: var(--t-xs);
    color: var(--a-faint);
  }

  .note {
    margin: 10px 0 0;
    font-size: var(--t-xs);
    color: var(--a-faint);
  }
</style>
