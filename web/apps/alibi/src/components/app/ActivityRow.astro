---
/**
 * One line of Home's activity: a bank's request or an Alibi alert, who it is
 * from, when, and its state in words in a pill (never colour alone). A full
 * row for a request links to its page: the trace, the private review and
 * approval. A compact row sits inside a Home card's button, so it is never a
 * link.
 */
import { day } from '@/lib/format';

import Pill from './Pill.astro';
import { initials, toneOf, type ActivityItem } from './home';

interface Props {
  item: ActivityItem;
  /** The request comes from a bank the holder trusts: approve and send in one tap. */
  trusted?: boolean;
  /** Inside a card preview: a plain row with no link and no chevron. */
  compact?: boolean;
  /** `/simulate/`: say whose review it awaits and that the link only views the request. */
  holder?: string;
}

const { item, trusted = false, compact = false, holder } = Astro.props;
const oneTap = trusted && item.kind === 'request' && item.state === 'awaiting';
const href = compact ? null : item.href;
const Tag = href ? 'a' : 'div';
const label = oneTap
  ? 'Trusted · approve in one tap'
  : holder && item.state === 'awaiting'
    ? `Awaiting ${holder}’s review`
    : item.label;
---

<li>
  <Tag
    class:list={['act', compact && 'act--compact']}
    href={href ?? undefined}
    aria-label={href && holder ? `View request from ${item.from}: ${item.title}` : undefined}
  >
    <span class:list={['mono', item.kind === 'alert' && 'mono--alert']} aria-hidden="true">
      {item.kind === 'alert' ? '!' : initials(item.from)}
    </span>
    <span class="body">
      <span class="from">
        {item.from} · {day(item.at)}
      </span>
      <span class="title">{item.title}</span>
      <span class="state">
        <Pill tone={toneOf(item.state)}>{label}</Pill>
        {href && holder && <span class="view">View request</span>}
      </span>
    </span>
    {href && (
      <svg class="go" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9 6l6 6-6 6" />
      </svg>
    )}
  </Tag>
</li>

<style>
  .act {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: center;
    gap: 12px;
    padding-block: 10px;
    color: inherit;
    text-decoration: none;
  }

  .act--compact {
    grid-template-columns: 36px 1fr;
    padding-block: 9px;
  }

  a.act:active {
    opacity: 0.6;
  }

  a.act:focus-visible {
    outline: 2px solid var(--a-accent);
    outline-offset: 2px;
    border-radius: 10px;
  }

  .mono {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--a-ink);
    color: var(--s-paper);
    font: 600 0.85rem/1 var(--a-display);
  }

  .act--compact .mono {
    width: 36px;
    height: 36px;
    font-size: 0.8rem;
  }

  .mono--alert {
    background: var(--a-tint);
    color: var(--a-warn);
    font-size: 1rem;
  }

  .body {
    display: grid;
    min-width: 0;
  }

  .from {
    font-size: var(--t-xs);
    color: var(--a-faint);
  }

  .title {
    font-weight: 500;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .state {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin-top: 5px;
  }

  .view {
    font-size: var(--t-xs);
    font-weight: 500;
    color: var(--a-accent);
  }

  .go {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--a-faint);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
