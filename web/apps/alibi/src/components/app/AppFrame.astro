---
/**
 * The dashboard's frame: one responsive web app for desktop and phone. On a desktop a top bar
 * carries the wordmark, the two sections (Home, Account) and the account avatar; on a phone the
 * sections move to a floating liquid-glass dock at the bottom. A one-line notice says when the
 * screen is not showing live backend data, and `/simulate/` adds a bar saying the visitor is
 * looking at Maya's dashboard, read-only, with a way to start their own.
 */
import { LiquidGlassSurface } from '@rawr-labs/liquid-glass/astro';

interface Props {
  holder?: string;
  /** Why the screen is showing built-in data instead of the backend's. */
  fixtureReason?: string;
  /** `passport` and `requests` are Home; `settings` is Account (older callers). */
  active: 'home' | 'account' | 'passport' | 'requests' | 'settings';
  /** Home uses the full width; other screens keep a readable column. */
  wide?: boolean;
  /** `/simulate/`: Maya's dashboard shown to a visitor, read-only. */
  simulation?: boolean;
}

const { holder = 'Maya', fixtureReason, active, wide = false, simulation = false } = Astro.props;
const tab = active === 'account' || active === 'settings' ? 'account' : 'home';
const sections = [
  {
    id: 'home',
    href: '/app/',
    label: 'Home',
    icon: 'M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5.5h-5V20H5a1 1 0 0 1-1-1z',
  },
  { id: 'account', href: '/app/account/', label: 'Account', icon: '' },
] as const;
---

<div class="app" class:list={{ wide }}>
  {simulation && (
    <div class="sim-bar">
      <p>
        <span class="sim-dot" aria-hidden="true"></span>
        You’re viewing Maya’s dashboard, live and read-only
      </p>
      <a href="/sign-up/">Start your own</a>
    </div>
  )}

  <header class="app-header">
    <div class="bar">
      <a href="/app/" class="mark">
        alibi
      </a>
      <nav class="tabs" aria-label="Dashboard">
        {sections.map((s) => (
          <a href={s.href} aria-current={tab === s.id ? 'page' : undefined}>
            {s.label}
          </a>
        ))}
      </nav>
      <a
        href="/app/account/"
        class="avatar"
        aria-label={`${holder}’s account`}
        aria-current={tab === 'account' ? 'page' : undefined}
      >
        {holder.slice(0, 1).toUpperCase()}
      </a>
    </div>
  </header>

  {fixtureReason && (
    <details class="fixture-note">
      <summary>Built-in case 1 data, not a live run</summary>
      <p>{fixtureReason}</p>
    </details>
  )}

  <main id="main" class="screen">
    <slot />
  </main>

  <nav class="dock-wrap" aria-label="App">
    <div class="dock">
      <LiquidGlassSurface
        id="app-dock-glass"
        class="dock-glass"
        radius="capsule"
        bezel={1}
        fillRefraction
        interiorLens="fisheye"
        deformationX={3}
        deformationY={3}
        frosted={6}
        frostedTint="white"
      />
      <div class="dock-items">
        <a href="/app/" aria-current={tab === 'home' ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={sections[0].icon} />
          </svg>
          <span>Home</span>
        </a>
        <a href="/app/account/" aria-current={tab === 'account' ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="8.5" r="3.75"></circle>
            <path d="M4.75 20c.9-3.6 3.75-5.5 7.25-5.5s6.35 1.9 7.25 5.5"></path>
          </svg>
          <span>Account</span>
        </a>
      </div>
    </div>
  </nav>
</div>

<style>
  .app {
    --a-ink: var(--s-ink);
    --a-soft: var(--s-ink-soft);
    /* Darker than the site's faint ink: small labels here carry information (AA, 4.5:1+). */
    --a-faint: #665e53;
    --a-line: var(--s-line);
    --a-accent: var(--s-accent);
    --a-accent-soft: var(--s-accent-soft);
    --a-ok: var(--s-ok);
    --a-bad: var(--s-bad);
    --a-warn: var(--c-warn);
    --a-tint: var(--s-paper-2);
    --a-display: var(--s-font-display);
    --a-body: var(--s-font-body);
    --a-mono: var(--s-font-mono);
    /* Page gutter and content width: phone first, wider on larger screens. */
    --a-gutter: var(--gutter);
    --a-max: 46rem;

    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--s-paper);
    color: var(--a-ink);
    font-family: var(--a-body);
  }

  .app.wide {
    --a-max: 76rem;
  }

  .sim-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 16px;
    padding: 10px var(--a-gutter);
    background: var(--a-ink);
    color: var(--s-paper);
    font-size: 0.875rem;
  }

  .sim-bar p {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
  }

  .sim-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #6fd39b;
    box-shadow: 0 0 0 3px rgb(111 211 155 / 0.25);
  }

  .sim-bar a {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--s-paper);
    color: var(--a-ink);
    font-weight: 500;
    text-decoration: none;
  }

  .app-header {
    border-bottom: 1px solid transparent;
  }

  .bar,
  .screen,
  .fixture-note {
    width: 100%;
    max-width: calc(var(--a-max) + 2 * var(--a-gutter));
    margin-inline: auto;
    padding-inline: var(--a-gutter);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-block: 14px 4px;
  }

  .mark {
    font: 600 1.45rem/1 var(--a-display);
    letter-spacing: -0.02em;
    color: inherit;
    text-decoration: none;
  }

  /* Desktop sections: hidden on a phone, where the dock carries them. */
  .tabs {
    display: none;
    gap: 4px;
  }

  .tabs a {
    padding: 8px 14px;
    border-radius: 10px;
    color: var(--a-soft);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
    transition:
      background-color 160ms var(--s-ease),
      color 160ms var(--s-ease);
  }

  .tabs a:hover {
    background: var(--a-tint);
  }

  .tabs a[aria-current='page'] {
    background: var(--a-tint);
    color: var(--a-ink);
  }

  .avatar {
    width: 34px;
    height: 34px;
    margin-left: auto;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--a-ink);
    color: var(--s-paper);
    font: 600 0.9rem/1 var(--a-display);
    text-decoration: none;
  }

  .fixture-note {
    margin-top: 6px;
    font-size: var(--t-xs);
    color: var(--a-faint);
  }

  .fixture-note summary {
    cursor: pointer;
    list-style: none;
  }

  .fixture-note summary::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 6px;
    border-radius: 50%;
    background: var(--a-warn);
    vertical-align: middle;
  }

  .fixture-note p {
    margin: 4px 0 0;
  }

  .screen {
    flex: 1;
    padding-top: var(--space-sm);
    padding-bottom: calc(120px + env(safe-area-inset-bottom));
  }

  .dock-wrap {
    position: fixed;
    left: 0;
    right: 0;
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 20;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .dock {
    position: relative;
    width: 216px;
    height: 64px;
    border-radius: 999px;
    pointer-events: auto;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.7) inset,
      0 10px 30px rgb(31 27 22 / 0.14),
      0 2px 6px rgb(31 27 22 / 0.06);
  }

  .dock-glass {
    position: absolute;
    inset: 0;
  }

  .dock-items {
    position: relative;
    z-index: 1;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    padding: 6px;
  }

  .dock-items a {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 2px;
    border-radius: 999px;
    color: var(--a-soft);
    text-decoration: none;
    font: 500 0.7rem/1 var(--a-body);
    transition:
      background 0.25s var(--s-ease),
      color 0.25s var(--s-ease);
  }

  .dock-items svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .dock-items a[aria-current='page'] {
    background: rgb(255 255 255 / 0.72);
    color: var(--a-ink);
    box-shadow: 0 1px 3px rgb(31 27 22 / 0.08);
  }

  .dock-items a[aria-current='page'] svg {
    fill: var(--a-ink);
    stroke-width: 1.4;
  }

  .dock-items a[aria-current='page'] svg path:last-child,
  .dock-items a[aria-current='page'] svg circle {
    fill: var(--a-ink);
  }

  /* Desktop and tablet: sections in the top bar, no dock. */
  @media (min-width: 768px) {
    .app {
      --a-gutter: clamp(24px, 4vw, 40px);
    }
    .app-header {
      border-bottom-color: var(--a-line);
    }
    .bar {
      padding-block: 16px;
    }
    .tabs {
      display: flex;
    }
    .screen {
      padding-top: 32px;
      padding-bottom: 80px;
    }
    .dock-wrap {
      display: none;
    }
  }
</style>
