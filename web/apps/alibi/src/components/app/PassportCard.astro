---
/**
 * Maya's passport as a card: a view of her signed evidence history, the
 * packages she approved and sent (the backend's `sharing_history`). It is a
 * portable record she chooses to share with a bank, not an identity
 * credential.
 */
import type { PassportHome } from '@/lib/api/types';
import { day } from '@/lib/format';

interface Props {
  data: PassportHome;
  /** Smaller, for the Account screen's link. */
  compact?: boolean;
}

const { data, compact = false } = Astro.props;
const packages = data.sharing_history;
const recipients = [...new Set(packages.map((p) => p.recipient))];
const latest = [...packages].sort((a, b) => b.sent_at.localeCompare(a.sent_at))[0];
---

<div class:list={['card', compact && 'card--compact']}>
  <div class="top">
    <span class="brand">alibi</span>
    <span class="kind">Shared evidence record</span>
  </div>
  <div class="who">
    <span class="name">{data.holder.name}</span>
    <span class="ref">{data.holder.subject_ref}</span>
  </div>
  <dl class="facts">
    <div>
      <dt>Signed packages</dt>
      <dd>{packages.length}</dd>
    </div>
    <div>
      <dt>Shared with</dt>
      <dd>{recipients.length === 0 ? 'No one yet' : recipients.join(', ')}</dd>
    </div>
    <div>
      <dt>Last sent</dt>
      <dd>{latest ? day(latest.sent_at) : '—'}</dd>
    </div>
  </dl>
</div>

<style>
  .card {
    position: relative;
    aspect-ratio: 1.586;
    width: 100%;
    padding: 20px 20px 18px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    border-radius: 22px;
    overflow: hidden;
    color: #f4f1ea;
    background:
      radial-gradient(120% 90% at 100% 0%, rgb(43 69 196 / 0.55), transparent 60%),
      radial-gradient(90% 80% at 0% 100%, rgb(31 122 74 / 0.28), transparent 65%),
      repeating-radial-gradient(
        circle at 82% 18%,
        rgb(255 255 255 / 0.05) 0 1px,
        transparent 1px 7px
      ),
      #15171d;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.12) inset,
      0 18px 40px rgb(21 23 29 / 0.28);
  }

  .card--compact {
    padding: 16px 18px 14px;
    border-radius: 18px;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .brand {
    font: 600 1.25rem/1 var(--a-display);
    letter-spacing: -0.02em;
  }

  .kind {
    font: 500 0.66rem/1 var(--a-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .who {
    align-self: center;
    display: grid;
    gap: 2px;
  }

  .name {
    font: 500 1.6rem/1.1 var(--a-display);
    letter-spacing: -0.02em;
  }

  .card--compact .name {
    font-size: 1.35rem;
  }

  .ref {
    font: 400 0.78rem/1.2 var(--a-mono);
    letter-spacing: 0.06em;
    opacity: 0.65;
  }

  .facts {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 12px;
  }

  .facts div {
    min-width: 0;
  }

  dt {
    font: 500 0.6rem/1.2 var(--a-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  dd {
    margin: 2px 0 0;
    font: 500 0.85rem/1.2 var(--a-body);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
