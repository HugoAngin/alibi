---
/**
 * Home: four cards (agents/eval/HOME_REDESIGN.md). Recent activity, Banks, Merchants and Financial
 * context each preview their list; a card opens the full list in a dialog (a bottom sheet on a
 * phone). Everything comes from the backend's JSON: the passport context, plus `GET /txn/<id>` for
 * each transaction's linked sources, reconciliation and claims. Nothing on Home approves or sends;
 * that happens on each request's page. `/app/` and `/simulate/` both render this component.
 */
import { ALIBI_API_ORIGIN } from 'astro:env/server';

import type { Money, PassportHome } from '@/lib/api/types';
import { day, money, when } from '@/lib/format';
import { ROUTES, backendHeaders } from '@/lib/screens';
import { TRUST_COOKIE, parseTrusted } from '@/lib/trust';
import { loadContext } from '@alibi/ui/api';
import { simulationActs } from '@/lib/simulationActs';

import ActivityRow from './ActivityRow.astro';
import DashboardSection from './DashboardSection.astro';
import Pill from './Pill.astro';
import {
  CLAIM_MARK,
  CONNECTION_LABEL,
  LINK_LABEL,
  TRUST_MARK,
  activity,
  banks as banksOf,
  byMonth,
  contextTimeline,
  describe,
  explain,
  headline,
  initials,
  isTxnDetail,
  merchants as merchantsOf,
  nextDue,
  plainName,
  requestHref,
  requestState,
  toneOf,
  type TxnDetail,
} from './home';

interface Props {
  data: PassportHome;
  /** `/simulate/`: read-only wording, and no links that ask a visitor to sign in. */
  simulation?: boolean;
}

const { data, simulation = false } = Astro.props;
const ACTIVITY_ON_HOME = 4;
const MERCHANTS_ON_HOME = 3;

const details = new Map<string, TxnDetail>();
await Promise.all(
  data.transactions.map(async (t) => {
    const loaded = await loadContext({
      origin: ALIBI_API_ORIGIN,
      path: ROUTES.txn(t.txn_id),
      isShape: isTxnDetail,
      fixture: () => null,
      headers: backendHeaders(),
    });
    if (loaded.source === 'live') details.set(t.txn_id, loaded.data);
  }),
);

const holder = data.holder.name;
const trusted = parseTrusted(Astro.cookies.get(TRUST_COOKIE)?.value);
const items = activity(data);
const waiting = items.filter((i) => i.state === 'awaiting' || i.state === 'open');
const earlier = items.filter((i) => !(i.state === 'awaiting' || i.state === 'open'));
const toReview = items.filter((i) => i.state === 'awaiting').length;
const due = nextDue(data);
const bankList = banksOf(data);
const merchantList = merchantsOf(data);
const context = contextTimeline(data, details);
const latest = context[0];
const timeline = byMonth(context);
const evidence = data.evidence_status;

// Read-only only when nobody can act as Maya here (the visitor can on a simulated site).
const readOnly = simulation && !simulationActs();
const readOnlyNote = `Read-only. Nothing here can approve or send for ${holder}.`;
const noChange = 'Opening this list changes nothing. Approval happens on each request’s page.';
const possessive = (name: string) => `${name}’s`;
const signed = (m: Money, direction: 'credit' | 'debit') =>
  `${direction === 'credit' ? '+' : '−'}${money({ ...m, minor: Math.abs(m.minor) })}`;
const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;
const requestsOf = (audience: string) =>
  data.requests.filter((r) => (r.audience || r.recipient) === audience);
---

<div class="dash">
  <section class="hello">
    <p class="hi">Hi {holder}</p>
    <h1 class="statement">{headline(data)}</h1>
    {due && (
      <p class="due">
        {possessive(due.recipient)} reply is due first, by {day(due.expires_at)}.
      </p>
    )}
  </section>

  <DashboardSection
    id="activity"
    title="Recent activity"
    count={items.length}
    hint="View all"
    summary={
      toReview > 0
        ? `${toReview} ${toReview === 1 ? 'needs' : 'need'} ${simulation ? `${possessive(holder)}` : 'your'} review`
        : 'Nothing needs your review'
    }
    lead="Bank requests and Alibi alerts, those waiting first, soonest reply first."
    note={readOnly ? readOnlyNote : noChange}
    class="card-activity"
  >
    <Fragment slot="preview">
      {items.length === 0 ? (
        <p class="quiet">No requests or alerts yet.</p>
      ) : (
        <ul class="rows rows--lined">
          {items.slice(0, ACTIVITY_ON_HOME).map((i) => (
            <ActivityRow
              item={i}
              compact
              trusted={i.audience ? trusted.has(i.audience) : false}
              holder={simulation ? holder : undefined}
            />
          ))}
        </ul>
      )}
    </Fragment>
    {items.length > ACTIVITY_ON_HOME && (
      <Fragment slot="footer">{items.length - ACTIVITY_ON_HOME} more in the full list</Fragment>
    )}

    {items.length === 0 && <p class="quiet">No requests or alerts yet.</p>}
    {waiting.length > 0 && (
      <>
        <h3 class="group">Needs {simulation ? possessive(holder) : 'your'} review</h3>
        <ul class="rows rows--lined">
          {waiting.map((i) => (
            <ActivityRow
              item={i}
              trusted={i.audience ? trusted.has(i.audience) : false}
              holder={simulation ? holder : undefined}
            />
          ))}
        </ul>
      </>
    )}
    {earlier.length > 0 && (
      <>
        <h3 class="group">Earlier</h3>
        <ul class="rows rows--lined">
          {earlier.map((i) => (
            <ActivityRow item={i} holder={simulation ? holder : undefined} />
          ))}
        </ul>
      </>
    )}
  </DashboardSection>

  <DashboardSection
    id="banks"
    title="Banks"
    count={bankList.length}
    hint="View all"
    summary={(() => {
      const n = bankList.filter((b) => b.awaiting > 0).length;
      return n > 0
        ? `${plural(n, 'bank')} waiting on ${simulation ? possessive(holder) : 'your'} review`
        : 'No bank is waiting on you';
    })()}
    lead="Banks that asked about your transactions, and the account feeds you connected."
    note={readOnly ? readOnlyNote : noChange}
    class="card-banks"
  >
    <Fragment slot="preview">
      {bankList.length === 0 ? (
        <p class="quiet">No bank has contacted your passport yet.</p>
      ) : (
        <ul class="rows rows--lined">
          {bankList.map((b) => (
            <li class="row">
              <span class="mono mono--ink" aria-hidden="true">
                {initials(b.name)}
              </span>
              <span class="row-body">
                <span class="row-title">
                  {b.name}
                  {trusted.has(b.audience) && <span class="trusted">Trusted</span>}
                </span>
                <span class="small">{b.feed ? 'Account feed connected' : 'Requests only'}</span>
              </span>
              {b.awaiting > 0 && <Pill tone="review">{b.awaiting} awaiting</Pill>}
            </li>
          ))}
        </ul>
      )}
    </Fragment>

    {bankList.length === 0 && <p class="quiet">No bank has contacted your passport yet.</p>}
    <ul class="detail-list">
      {bankList.map((b) => {
        const awaitingRequests = requestsOf(b.audience).filter(
          (r) => requestState(r.status) === 'awaiting',
        );
        return (
          <li class="detail">
            <div class="detail-head">
              <span class="mono mono--ink" aria-hidden="true">
                {initials(b.name)}
              </span>
              <span class="row-body">
                <span class="row-title">
                  {b.name}
                  {trusted.has(b.audience) && <span class="trusted">Trusted</span>}
                </span>
                <span class="small">{b.feed ? 'Account feed connected' : 'Requests only'}</span>
              </span>
              {b.awaiting > 0 && <Pill tone="review">{b.awaiting} awaiting</Pill>}
            </div>
            <dl class="facts">
              {b.feed && (
                <div>
                  <dt>Account feed</dt>
                  <dd>
                    {plainName(b.feed.name)} · {plural(b.feed.record_count, 'record')} · synced{' '}
                    {when(b.feed.last_synced_at)}
                  </dd>
                </div>
              )}
              <div>
                <dt>Requests</dt>
                <dd>{b.requests}</dd>
              </div>
              <div>
                <dt>Packages sent</dt>
                <dd>{b.packagesSent}</dd>
              </div>
            </dl>
            {(awaitingRequests.length > 0 || !simulation) && (
              <p class="links">
                {awaitingRequests.map((r) => (
                  <a href={requestHref(r.request_id)}>
                    {simulation ? 'View request' : 'Review request'} ·{' '}
                    {plural(r.question_count, 'question')}, reply by {day(r.expires_at)}
                  </a>
                ))}
                {!simulation && (
                  <a href={`/app/banks/${encodeURIComponent(b.audience)}/`}>
                    {possessive(b.name)} page
                  </a>
                )}
              </p>
            )}
          </li>
        );
      })}
    </ul>
  </DashboardSection>

  <DashboardSection
    id="merchants"
    title="Merchants"
    count={merchantList.length}
    hint="View all"
    summary={
      merchantList.length === 0
        ? 'No merchant connected yet'
        : `${plural(
            merchantList.filter((m) => m.status === 'connected').length,
            'connection',
          )} working`
    }
    lead="Merchants that send Alibi signed records of your sales, refunds and payouts."
    class="card-merchants"
  >
    <Fragment slot="preview">
      {merchantList.length === 0 ? (
        <p class="quiet">No merchant is connected yet.</p>
      ) : (
        <ul class="rows rows--lined">
          {merchantList.slice(0, MERCHANTS_ON_HOME).map((m) => (
            <li class="row">
              <span class="mono" aria-hidden="true">
                {initials(m.name)}
              </span>
              <span class="row-body">
                <span class="row-title">{plainName(m.name)}</span>
                <span class="small">Synced {day(m.last_synced_at)}</span>
              </span>
              <Pill tone={toneOf(m.status)}>{CONNECTION_LABEL[m.status]}</Pill>
            </li>
          ))}
        </ul>
      )}
    </Fragment>
    {merchantList.length > MERCHANTS_ON_HOME && (
      <Fragment slot="footer">
        {merchantList.length - MERCHANTS_ON_HOME} more in the full list
      </Fragment>
    )}

    {merchantList.length === 0 && <p class="quiet">No merchant is connected yet.</p>}
    <ul class="detail-list">
      {merchantList.map((m) => (
        <li class="detail">
          <div class="detail-head">
            <span class="mono" aria-hidden="true">
              {initials(m.name)}
            </span>
            <span class="row-body">
              <span class="row-title">{plainName(m.name)}</span>
              <span class="small">{TRUST_MARK[m.trust].label}</span>
            </span>
            <Pill tone={toneOf(m.status)}>{CONNECTION_LABEL[m.status]}</Pill>
          </div>
          <dl class="facts">
            <div>
              <dt>Records</dt>
              <dd>{m.record_count}</dd>
            </div>
            <div>
              <dt>Last synced</dt>
              <dd>{when(m.last_synced_at)}</dd>
            </div>
          </dl>
        </li>
      ))}
    </ul>
    {merchantList.length > 0 && !simulation && (
      <p class="links">
        <a href="/app/merchants/">Merchant details and connections</a>
      </p>
    )}
  </DashboardSection>

  <DashboardSection
    id="context"
    title="Financial context"
    count={context.length}
    hint="Full timeline"
    summary={`${evidence.linked} of ${evidence.total} transactions explained · checked ${day(evidence.last_checked_at)}`}
    lead="Your transactions, joined to the records that explain them and what Alibi could establish."
    wide
    class="card-context"
  >
    <Fragment slot="preview">
      {latest ? (
        <div class="latest">
          <div class="latest-line">
            <span class="row-title">{describe(latest.title).title}</span>
            <span class:list={['amount', `amount--${latest.direction}`]}>
              {signed(latest.amount, latest.direction)}
            </span>
          </div>
          <p class="small">{day(latest.at)} · newest transaction</p>
          <p class="explain">{explain(latest)}</p>
          <Pill tone={toneOf(latest.linkState)}>{LINK_LABEL[latest.linkState]}</Pill>
        </div>
      ) : (
        <p class="quiet">No transactions yet.</p>
      )}
    </Fragment>

    {timeline.length === 0 && <p class="quiet">No transactions yet.</p>}
    {timeline.map((g, gi) => (
      <div class="month">
        <h3 class="month-title">{g.month}</h3>
        <ol class="timeline">
          {g.entries.map((e, ei) => (
            <li class="entry">
              <details open={gi === 0 && ei === 0}>
                <summary>
                  <span class="entry-date">
                    <span class="d">{day(e.at).split(' ')[0]}</span>
                    <span class="m">{day(e.at).split(' ')[1]}</span>
                  </span>
                  <span class="entry-main">
                    <span class="entry-line">
                      <span class="entry-title">{describe(e.title).title}</span>
                      <span class:list={['amount', `amount--${e.direction}`]}>
                        {signed(e.amount, e.direction)}
                      </span>
                    </span>
                    {describe(e.title).line && (
                      <span class="entry-line2">{describe(e.title).line}</span>
                    )}
                    <span class="explain">{explain(e)}</span>
                    <span class="entry-tags">
                      <Pill tone={toneOf(e.linkState)}>{LINK_LABEL[e.linkState]}</Pill>
                      {e.claims.map((c) => (
                        <Pill tone={toneOf(c.status)}>
                          {CLAIM_MARK[c.status].label}
                          {c.bank && ` for ${c.bank}`}
                        </Pill>
                      ))}
                      <span class="small">
                        {e.sources.length === 0
                          ? 'Bank record only'
                          : `${plural(e.sources.length, 'related record')}`}
                      </span>
                    </span>
                  </span>
                </summary>
                <div class="entry-detail">
                  <h4 class="sub">Sources</h4>
                  <ul class="sources">
                    <li>
                      <span class="src-who">{e.observedBy} · bank transaction</span>
                      <span class="small">
                        {TRUST_MARK.bank_observed.label} · <code>{e.id}</code>
                        {e.references.length > 0 && ` · Reference ${e.references.join(', ')}`}
                      </span>
                    </li>
                    {e.sources.map((s) => (
                      <li>
                        <span class="src-who">
                          {plainName(s.issuer)} · {s.kind.replaceAll('_', ' ')}
                        </span>
                        <span class="small">
                          {TRUST_MARK[s.trust].label}
                          {s.via_lookup && ' · by lookup'} · {day(s.occurred_at)} ·{' '}
                          {money(s.amount)} · {s.status.replaceAll('_', ' ')} ·{' '}
                          <code>
                            {s.record_id} r{s.revision}
                          </code>
                        </span>
                      </li>
                    ))}
                  </ul>
                  {e.calculation && (
                    <>
                      <h4 class="sub">
                        Reconciliation · {e.calculation.matches ? 'adds up' : 'does not add up'}
                      </h4>
                      <table class="recon">
                        <tbody>
                          {e.calculation.lines.map((l) => (
                            <tr>
                              <th scope="row">{l.label}</th>
                              <td class="small">{plural(l.source_ids.length, 'record')}</td>
                              <td class="num">
                                {l.sign === '+' ? '+' : '−'}
                                {money(l.amount)}
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                      <p class="pence">
                        <code>{e.calculation.expression}</code>
                      </p>
                    </>
                  )}
                  {e.claims.length > 0 && (
                    <>
                      <h4 class="sub">Answers to banks</h4>
                      <ul class="sources">
                        {e.claims.map((c) => (
                          <li>
                            <span class="src-who">{c.question}</span>
                            <span class="claim">
                              <Pill tone={toneOf(c.status)}>{CLAIM_MARK[c.status].label}</Pill>
                              {c.bank && <span class="small">asked by {c.bank}</span>}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </>
                  )}
                </div>
              </details>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </DashboardSection>
</div>

<style>
  .dash {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 960px) {
    .dash {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 24px;
    }
    .hello {
      grid-column: 1 / -1;
    }
    .dash :global(.card-activity),
    .dash :global(.card-context) {
      grid-column: span 7;
    }
    .dash :global(.card-banks),
    .dash :global(.card-merchants) {
      grid-column: span 5;
    }
    .statement {
      max-width: 24ch;
      font-size: 2.5rem;
    }
  }

  .hello {
    padding-block: 18px 6px;
  }

  .hi {
    margin: 0 0 6px;
    font-size: var(--t-sm);
    color: var(--a-faint);
  }

  .statement {
    margin: 0;
    font: 500 1.85rem/1.12 var(--a-display);
    letter-spacing: -0.025em;
    max-width: 16ch;
  }

  .due {
    margin: 10px 0 0;
    color: var(--a-soft);
    font-size: var(--t-sm);
  }

  .trusted {
    margin-left: 6px;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--a-accent-soft);
    color: var(--a-accent);
    font: 500 0.6875rem/1.5 var(--a-body);
    vertical-align: middle;
  }

  .quiet,
  .small {
    font-size: var(--t-xs);
    color: var(--a-faint);
  }

  .quiet {
    margin: 0 0 8px;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rows--lined > :global(li + li) {
    border-top: 1px solid var(--s-line);
  }

  .row,
  .detail-head {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding-block: 9px;
  }

  .row-body {
    display: grid;
    min-width: 0;
  }

  .row-title {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .mono {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--a-tint);
    font: 600 0.8rem/1 var(--a-display);
    color: var(--a-soft);
  }

  .mono--ink {
    background: var(--a-ink);
    color: var(--s-paper);
  }

  .group {
    margin: 16px 0 2px;
    font: 600 var(--t-xs)/1.2 var(--a-body);
    color: var(--a-faint);
  }

  .detail-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .detail {
    padding-block: 12px;
  }

  .detail + .detail {
    border-top: 1px solid var(--s-line);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 8px 16px;
    margin: 6px 0 0 48px;
  }

  .facts dt {
    font-size: var(--t-xs);
    color: var(--a-faint);
  }

  .facts dd {
    margin: 0;
    font-size: var(--t-sm);
  }

  .links {
    display: grid;
    gap: 6px;
    justify-items: start;
    margin: 10px 0 0 48px;
  }

  .links a {
    color: var(--a-accent);
    font-size: var(--t-sm);
    font-weight: 500;
  }

  .latest {
    display: grid;
    justify-items: start;
    gap: 4px;
    padding-left: 12px;
    border-left: 2px solid var(--a-accent);
  }

  .latest-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
  }

  .latest .small {
    margin: 0;
  }

  .explain {
    margin: 4px 0;
    color: var(--a-soft);
    font-size: var(--t-sm);
    line-height: 1.45;
  }

  .month {
    margin-top: 8px;
  }

  .month-title {
    position: sticky;
    z-index: 1;
    top: -8px;
    margin: 0;
    padding: 10px 0 6px;
    background: var(--s-paper);
    font: 600 var(--t-xs)/1 var(--a-body);
    color: var(--a-faint);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 21px;
    top: 14px;
    bottom: 14px;
    width: 1px;
    background: var(--s-line);
  }

  .entry summary {
    position: relative;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 10px;
    padding-block: 12px;
    cursor: pointer;
    list-style: none;
    border-radius: 12px;
  }

  .entry summary:focus-visible {
    outline: 2px solid var(--a-accent);
    outline-offset: 2px;
  }

  .entry summary::-webkit-details-marker {
    display: none;
  }

  .entry-date {
    position: relative;
    z-index: 0;
    align-self: start;
    justify-self: center;
    display: grid;
    width: 40px;
    padding: 2px 0 4px;
    background: var(--s-paper);
    text-align: center;
    color: var(--a-faint);
  }

  .entry-date .d {
    font: 600 1.05rem/1.1 var(--a-display);
    color: var(--a-ink);
  }

  .entry-date .m {
    font: 500 0.68rem/1.2 var(--a-body);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .entry-main {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .entry-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .entry-title {
    font-weight: 600;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .entry-line2 {
    font: 400 0.75rem/1.3 var(--a-mono);
    color: var(--a-faint);
  }

  .entry-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
  }

  .entry-detail {
    margin: 0 0 12px 54px;
    padding: 12px 16px;
    border-radius: 14px;
    background: var(--s-card);
    border: 1px solid var(--s-line);
  }

  .sub {
    margin: 12px 0 6px;
    font: 600 var(--t-xs)/1.2 var(--a-body);
    color: var(--a-faint);
  }

  .sub:first-child {
    margin-top: 0;
  }

  .sources {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .sources li {
    display: grid;
    gap: 1px;
  }

  .src-who {
    font-size: var(--t-sm);
  }

  .claim {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 3px;
  }

