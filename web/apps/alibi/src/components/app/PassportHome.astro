---
/**
 * Maya's passport home. Order follows docs/FRONTEND.md: alerts and open
 * requests first, then her history, then rules and connections.
 */
import type { PassportHome } from '@/lib/api/types';
import { day, money, when } from '@/lib/format';

import Badge from './Badge.astro';

interface Props {
  data: PassportHome;
}

const { data } = Astro.props;
const openAlerts = data.alerts.filter((a) => a.status === 'open');
const pastAlerts = data.alerts.filter((a) => a.status !== 'open');
const openRequests = data.requests.filter(
  (r) => !['sent', 'refused', 'expired'].includes(r.status),
);
const es = data.evidence_status;
---

<h1 class="title">Your passport</h1>

<section aria-labelledby="alerts-title" class="block">
  <h2 id="alerts-title">Alerts</h2>
  {openAlerts.length === 0 && <p class="empty">Nothing needs your attention.</p>}
  <ul class="list">
    {[...openAlerts, ...pastAlerts].map((a) => (
      <li
        class:list={[
          'card',
          'alert',
          `alert--${a.severity}`,
          a.status === 'resolved' && 'alert--resolved',
        ]}
      >
        <p class="meta">
          {when(a.created_at)} · <Badge kind="status" value={a.status} />
        </p>
        <p class="headline">{a.title}</p>
      </li>
    ))}
  </ul>
</section>

<section id="requests" aria-labelledby="requests-title" class="block">
  <h2 id="requests-title">Requests from banks</h2>
  {openRequests.length === 0 && <p class="empty">No bank has asked you anything.</p>}
  <ul class="list">
    {openRequests.map((r) => (
      <li class="card request">
        <a href={r.href} class="request-link">
          <span class="headline">
            {r.recipient} asks{' '}
            {r.question_count === 1 ? '1 question' : `${r.question_count} questions`}
          </span>
          <span class="meta">
            Received {when(r.received_at)} · reply by {day(r.expires_at)}
          </span>
          <Badge kind="status" value={r.status} />
        </a>
      </li>
    ))}
  </ul>
</section>

<section aria-labelledby="history-title" class="block">
  <h2 id="history-title">Payments</h2>
  <ul class="list">
    {data.transactions.map((t) => (
      <li class="card txn">
        <div class="txn-main">
          <span class="headline">{t.description}</span>
          <span class="meta">{when(t.booked_at)}</span>
        </div>
        <div class="txn-side">
          <span class:list={['amount', `amount--${t.direction}`]}>{money(t.amount)}</span>
          {t.direction === 'credit' && (
            <Badge
              kind="link"
              value={t.link_state}
              label={t.link_state === 'linked' ? 'Explained' : undefined}
            />
          )}
        </div>
      </li>
    ))}
  </ul>
  <p class="meta">
    {es.linked} of {es.total} payments linked to records · checked {when(es.last_checked_at)}
    {es.superseded_sources > 0 && ` · ${es.superseded_sources} older record versions kept`}
  </p>
</section>

<section aria-labelledby="sharing-title" class="block">
  <h2 id="sharing-title">What you have shared</h2>
  {data.sharing_history.length === 0 && (
    <p class="empty">Nothing yet. Each package you approve is listed here.</p>
  )}
  <ul class="list">
    {data.sharing_history.map((s) => (
      <li class="card">
        <p class="headline">
          {s.item_count} items to {s.recipient}
        </p>
        <p class="meta">
          Sent {when(s.sent_at)} · expires {day(s.expires_at)} ·{' '}
          <Badge kind="status" value={s.status} />
        </p>
      </li>
    ))}
  </ul>
</section>

<section aria-labelledby="rules-title" class="block">
  <h2 id="rules-title">Your privacy rules</h2>
  <ul class="list">
    {data.rules.map((r) => (
      <li class="card">
        <p class="headline">“{r.text}”</p>
        <p class="meta">
          {r.summary} <Badge kind="status" value={r.status} />
        </p>
      </li>
    ))}
  </ul>
</section>

<section aria-labelledby="connections-title" class="block">
  <h2 id="connections-title">Connections</h2>
  <ul class="list">
    {data.connections.map((c) => (
      <li class="card">
        <p class="headline">
          {c.name} <Badge kind="trust" value={c.trust} />
        </p>
        <p class="meta">
          {c.record_count} records · synced {when(c.last_synced_at)}
        </p>
      </li>
    ))}
  </ul>
</section>

<style>
  .title {
    font-size: var(--t-lg);
  }

  .block {
    margin-block: var(--space-md);
  }

  h2 {
    font-size: var(--t-md);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  .card {
    padding: var(--space-xs) var(--space-sm);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-md);
  }

  .card p {
    margin: 0;
  }

  .headline {
    font-weight: 600;
  }

  .meta,
  .empty {
    font-size: var(--t-xs);
    color: var(--c-ink-faint);
  }

  .alert {
    border-left-width: 4px;
  }
  .alert--warning,
  .alert--high {
    border-left-color: var(--c-warn);
  }
  .alert--resolved {
    opacity: 0.75;
  }

  .request-link {
    display: grid;
    gap: var(--space-3xs);
    justify-items: start;
    text-decoration: none;
  }

  .txn {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .txn-main {
    display: grid;
    min-width: 0;
  }

  .txn-side {
    display: grid;
    justify-items: end;
    gap: var(--space-3xs);
  }

  .amount {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .amount--credit {
    color: var(--c-ok);
  }
</style>
