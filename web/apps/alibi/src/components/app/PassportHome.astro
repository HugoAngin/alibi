---
/**
 * Home: what is waiting on Maya, then the banks and merchants her passport
 * knows, then Financial Context, one timeline of her transactions joined to
 * the records that explain them. Everything comes from the backend's JSON:
 * the passport context, plus `GET /txn/<id>` for each transaction's linked
 * sources and claims. With no backend, the transactions show on their own.
 */
import { ALIBI_API_ORIGIN } from 'astro:env/server';

import type { PassportHome } from '@/lib/api/types';
import { day, money } from '@/lib/format';
import { ROUTES, backendHeaders } from '@/lib/screens';
import { TRUST_COOKIE, parseTrusted } from '@/lib/trust';
import { loadContext } from '@alibi/ui/api';

import ActivityRow from './ActivityRow.astro';
import DashboardSection from './DashboardSection.astro';
import {
  CLAIM_MARK,
  LINK_MARK,
  TRUST_MARK,
  activity,
  banks as banksOf,
  byMonth,
  contextTimeline,
  describe,
  headline,
  initials,
  isTxnDetail,
  merchants as merchantsOf,
  plainName,
  type ContextEntry,
  type TxnDetail,
} from './home';

interface Props {
  data: PassportHome;
}

const { data } = Astro.props;
const ACTIVITY_ON_HOME = 3;
const CONNECTIONS_ON_HOME = 2;

const details = new Map<string, TxnDetail>();
await Promise.all(
  data.transactions.map(async (t) => {
    const loaded = await loadContext({
      origin: ALIBI_API_ORIGIN,
      path: ROUTES.txn(t.txn_id),
      isShape: isTxnDetail,
      fixture: () => null,
      headers: backendHeaders(),
    });
    if (loaded.source === 'live') details.set(t.txn_id, loaded.data);
  }),
);

const trusted = parseTrusted(Astro.cookies.get(TRUST_COOKIE)?.value);
const items = activity(data);
const recent = items.slice(0, ACTIVITY_ON_HOME);
const bankList = banksOf(data);
const merchantList = merchantsOf(data);
const context = contextTimeline(data, details);
const latest = context[0];
const timeline = byMonth(context);
const contextText = (entry: ContextEntry) =>
  entry.linkedCount > 0 && entry.sources.length === 0
    ? 'Linked evidence details are unavailable here.'
    : entry.context;
const signed = (m: { minor: number; currency: string }, direction: 'credit' | 'debit') =>
  `${direction === 'credit' ? '+' : '−'}${money({ ...m, minor: Math.abs(m.minor) })}`;
---

<div class="dash">
  <section class="hello">
    <p class="hi">Hi {data.holder.name}</p>
    <h1 class="statement">{headline(data)}</h1>
  </section>

  <DashboardSection
    id="requests"
    title="Recent activity"
    action="View all activity"
    count={items.length}
    class="activity-card"
  >
    <Fragment slot="preview">
      {recent.length === 0 ? (
        <p class="quiet">No requests or alerts yet.</p>
      ) : (
        <ul class="preview-list">
          {recent.map((item) => (
            <li>
              <span class="preview-name">{item.from}</span>
              <span class="preview-meta">
                {item.title} · {day(item.at)}
              </span>
              <span
                class:list={[
                  'preview-state',
                  (item.state === 'awaiting' || item.state === 'open') && 'preview-state--waiting',
                ]}
              >
                {item.label}
              </span>
            </li>
          ))}
        </ul>
      )}
    </Fragment>
    {items.length === 0 && <p class="quiet">No requests or alerts yet.</p>}
    <ul class="rows">
      {items.map((i) => (
        <ActivityRow item={i} trusted={i.audience ? trusted.has(i.audience) : false} />
      ))}
    </ul>
  </DashboardSection>

  <DashboardSection
    id="banks"
    title="Banks"
    action="View all banks"
    count={bankList.length}
    class="banks-card"
  >
    <Fragment slot="preview">
      {bankList.length === 0 ? (
        <p class="quiet">No bank has contacted your passport yet.</p>
      ) : (
        <ul class="preview-list">
          {bankList.slice(0, CONNECTIONS_ON_HOME).map((bank) => (
            <li>
              <span class="preview-name">
                {bank.name}
                {trusted.has(bank.audience) && <span class="trusted">Trusted</span>}
              </span>
              <span class="preview-meta">
                {bank.feed ? 'Account feed connected' : 'Sends you requests'}
              </span>
              {bank.awaiting > 0 && (
                <span class="preview-state preview-state--waiting">
                  {bank.awaiting} awaiting review
                </span>
              )}
            </li>
          ))}
        </ul>
      )}
    </Fragment>
    {bankList.length === 0 && <p class="quiet">No bank has contacted your passport yet.</p>}
    <ul class="banks">
      {bankList.map((b) => (
        <li>
          <a class="bank" href={`/app/banks/${encodeURIComponent(b.audience)}/`}>
            <span class="mono mono--lg mono--ink" aria-hidden="true">
              {initials(b.name)}
            </span>
            <span class="bank-name">
              {b.name}
              {trusted.has(b.audience) && <span class="trusted">Trusted</span>}
            </span>
            <span class="small">{b.feed ? 'Account feed connected' : 'Sends you requests'}</span>
            <span class="small">
              {b.awaiting > 0
                ? `${b.awaiting} awaiting your review`
                : b.packagesSent > 0
                  ? `${b.packagesSent} ${b.packagesSent === 1 ? 'package' : 'packages'} sent`
                  : `${b.requests} ${b.requests === 1 ? 'request' : 'requests'}`}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </DashboardSection>

  <DashboardSection
    id="merchants"
    title="Merchants"
    action="View all merchants"
    count={merchantList.length}
    class="merchants-card"
  >
    <Fragment slot="preview">
      {merchantList.length === 0 ? (
        <p class="quiet">No merchant is connected yet.</p>
      ) : (
        <ul class="preview-list">
          {merchantList.slice(0, CONNECTIONS_ON_HOME).map((merchant) => (
            <li>
              <span class="preview-name">{plainName(merchant.name)}</span>
              <span class="preview-meta">
                {merchant.record_count} records · synced {day(merchant.last_synced_at)}
              </span>
              <span class="preview-state">{TRUST_MARK[merchant.trust].label}</span>
            </li>
          ))}
        </ul>
      )}
    </Fragment>
    {merchantList.length === 0 && <p class="quiet">No merchant is connected yet.</p>}
    <ul class="rows">
      {merchantList.map((m) => (
        <li class="row">
          <span class="mono" aria-hidden="true">
            {initials(m.name)}
          </span>
          <span class="row-body">
            <span class="row-title">{plainName(m.name)}</span>
            <span class="small">
              {m.record_count} records · synced {day(m.last_synced_at)}
            </span>
          </span>
          <span class="trust" title={TRUST_MARK[m.trust].label}>
            {TRUST_MARK[m.trust].label}
          </span>
        </li>
      ))}
    </ul>
    {merchantList.length > 0 && (
      <a class="row-link" href="/app/merchants/">
        View all merchants and their details
      </a>
    )}
  </DashboardSection>

  <DashboardSection
    id="financial-context"
    title="Financial context"
    action="View transaction history"
    class="context-card"
  >
    <Fragment slot="preview">
      {latest ? (
        <div class="latest">
          <div class="latest-line">
            <span class="preview-name">{describe(latest.title).title}</span>
            <span class:list={['amount', `amount--${latest.direction}`]}>
              {signed(latest.amount, latest.direction)}
            </span>
          </div>
          <p class="preview-meta">
            {day(latest.at)} · {LINK_MARK[latest.linkState].label}
          </p>
          <p class="latest-context">{contextText(latest)}</p>
        </div>
      ) : (
        <p class="quiet">No transactions yet.</p>
      )}
    </Fragment>
    <p class="quiet">
      Your transactions, joined to the records that explain them and what Alibi could establish.
      {data.evidence_status.linked} of {data.evidence_status.total} linked · checked{' '}
      {day(data.evidence_status.last_checked_at)}.
    </p>
    {timeline.length === 0 && <p class="quiet">No transactions yet.</p>}
    {timeline.map((g) => (
      <div class="month">
        <h3 class="month-title">{g.month}</h3>
        <ol class="timeline">
          {g.entries.map((e) => (
            <li class:list={['entry', `entry--${e.linkState}`]}>
              <details>
                <summary>
                  <span class="entry-date">
                    <span class="d">{day(e.at).split(' ')[0]}</span>
                    <span class="m">{day(e.at).split(' ')[1]}</span>
                  </span>
                  <span class="entry-main">
                    <span class="entry-line">
                      <span class="entry-title">{describe(e.title).title}</span>
                      <span class:list={['amount', `amount--${e.direction}`]}>
                        {signed(e.amount, e.direction)}
                      </span>
                    </span>
                    {describe(e.title).line && (
                      <span class="entry-line2">{describe(e.title).line}</span>
                    )}
                    {e.context && <span class="entry-context">{contextText(e)}</span>}
                    <span class="entry-tags">
                      <span class:list={['tag', `tag--${e.linkState}`]}>
                        {e.linkState === 'linked' && e.linkedCount > 0
                          ? `Linked to ${e.linkedCount}`
                          : LINK_MARK[e.linkState].label}
                      </span>
                      {e.claims.map((c) => (
                        <span class:list={['tag', `tag--${c.status}`]}>
                          {CLAIM_MARK[c.status].label}
                          {c.bank && ` for ${c.bank}`}
                        </span>
                      ))}
                      {(e.sources.length > 0 || e.linkedCount === 0) && (
                        <span class="src-count">
                          {e.sources.length === 0
                            ? 'Bank record only'
                            : `${e.sources.length} related ${e.sources.length === 1 ? 'record' : 'records'}`}
                        </span>
                      )}
                    </span>
                  </span>
                </summary>
                <ul class="sources">
                  <li>
                    <span class="trust">
                      <span aria-hidden="true">{TRUST_MARK.bank_observed.mark}</span>{' '}
                      {TRUST_MARK.bank_observed.label}
                    </span>
                    <span class="src-who">{e.observedBy}</span>
                    <code>{e.id}</code>
                    {e.references.length > 0 && (
                      <span class="small">Reference {e.references.join(', ')}</span>
                    )}
                  </li>
                  {e.sources.map((s) => (
                    <li>
                      <span class="trust">
                        {TRUST_MARK[s.trust].label}
                        {s.via_lookup && ' · by lookup'}
                      </span>
                      <span class="src-who">
                        {plainName(s.issuer)} · {s.kind.replaceAll('_', ' ')}
                      </span>
                      <code>
                        {s.record_id} r{s.revision}
                      </code>
                      <span class="small">
                        {day(s.occurred_at)} · {money(s.amount)} · {s.status.replaceAll('_', ' ')}
                      </span>
                    </li>
                  ))}
                  {e.claims.map((c) => (
                    <li>
                      <span class="trust">
                        {CLAIM_MARK[c.status].label}
                        {c.bank && ` · asked by ${c.bank}`}
                      </span>
                      <span class="src-who">{c.question}</span>
                    </li>
                  ))}
                  {e.calculation && (
                    <li>
                      <span class="trust">
                        {e.calculation.matches ? 'Reconciles' : 'Does not reconcile'}
                      </span>
                      <code>{e.calculation.expression}</code>
                    </li>
                  )}
                </ul>
              </details>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </DashboardSection>
</div>

<style>
  a.bank {
    color: inherit;
    text-decoration: none;
  }

  .trusted {
    margin-left: 6px;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--a-accent-soft);
    color: var(--a-accent);
    font: 500 0.6875rem/1.5 var(--a-body);
    vertical-align: middle;
  }

  .dash {
    display: grid;
    gap: 14px;
  }

  @media (min-width: 760px) {
    .dash {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 18px;
    }
    .hello {
      grid-column: 1 / -1;
    }
    .dash :global(.activity-card),
    .dash :global(.context-card) {
      grid-column: span 7;
    }
    .dash :global(.banks-card),
    .dash :global(.merchants-card) {
      grid-column: span 5;
    }
    .dash .statement {
      max-width: 24ch;
      font-size: 2.5rem;
    }
  }

  .hello {
    padding-block: 18px 6px;
  }

  .hi {
    margin: 0 0 6px;
    font-size: var(--t-sm);
    color: var(--a-faint);
  }

  .statement {
    margin: 0;
    font: 500 1.85rem/1.12 var(--a-display);
    letter-spacing: -0.025em;
    max-width: 16ch;
  }

  .preview-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .preview-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px 12px;
    padding-block: 10px;
    border-top: 1px solid var(--a-line);
  }

  .preview-name {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .preview-list .preview-meta {
    grid-row: 2;
  }

  .preview-meta,
  .preview-state {
    margin: 0;
    color: var(--a-faint);
    font-size: var(--t-xs);
  }

  .preview-state {
    align-self: start;
    justify-self: end;
    max-width: 12ch;
    text-align: right;
    font-weight: 500;
  }

  .preview-state--waiting {
    color: var(--a-accent);
  }

  .latest {
    padding-left: 12px;
    border-left: 2px solid var(--a-accent);
  }

  .latest-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 3px;
  }

  .latest-context {
    margin: 8px 0 0;
    color: var(--a-soft);
    font-size: var(--t-sm);
    line-height: 1.45;
  }

  .row-link {
    color: var(--a-accent);
    font-size: var(--t-sm);
    font-weight: 500;
    display: inline-block;
    margin-top: 6px;
  }

  .quiet,
  .small {
    font-size: var(--t-xs);
    color: var(--a-faint);
  }

  .quiet {
    margin: 0 0 8px;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: center;
    gap: 12px;
    padding-block: 10px;
  }

  .row-body {
    display: grid;
    min-width: 0;
  }

  .row-title {
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mono {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--a-tint);
    font: 600 0.85rem/1 var(--a-display);
    color: var(--a-soft);
  }

  .mono--lg {
    width: 48px;
    height: 48px;
    border-radius: 16px;
    font-size: 1.1rem;
  }

  .mono--ink {
    background: var(--a-ink);
    color: var(--s-paper);
  }

  .banks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 16px;
  }

  .bank {
    display: grid;
    gap: 2px;
    justify-items: start;
  }

  .bank .mono {
    margin-bottom: 8px;
  }

  .bank-name {
    font-weight: 600;
  }

  .trust {
    font-size: var(--t-xs);
    color: var(--a-soft);
    white-space: nowrap;
  }

  .month {
    margin-top: 18px;
  }

  .month-title {
    margin: 0 0 6px;
    font: 500 0.75rem/1 var(--a-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--a-faint);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 21px;
    top: 14px;
    bottom: 14px;
    width: 1px;
    background: var(--a-line);
  }

  .entry summary {
    position: relative;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 10px;
    padding-block: 12px;
    cursor: pointer;
    list-style: none;
  }

  .entry summary::-webkit-details-marker,
  :global(.fixture-note summary::-webkit-details-marker) {
    display: none;
  }

  .entry-date {
    position: relative;
    z-index: 1;
    align-self: start;
    justify-self: center;
    display: grid;
    width: 40px;
    padding: 2px 0 4px;
    background: var(--s-paper);
    text-align: center;
    color: var(--a-faint);
  }

  .entry-date .d {
    font: 600 1.05rem/1.1 var(--a-display);
    color: var(--a-ink);
  }

  .entry-date .m {
    font: 500 0.68rem/1.2 var(--a-body);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .entry-line2 {
    margin-top: -2px;
    font: 400 0.75rem/1.3 var(--a-mono);
    color: var(--a-faint);
  }

  .entry-main {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .entry-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .entry-title {
    font-weight: 500;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .entry-context {
    font-size: var(--t-sm);
    color: var(--a-soft);
    line-height: 1.45;
  }

  .entry-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin-top: 2px;
  }

  .tag {
    display: inline-flex;
    gap: 4px;
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--a-soft);
  }

  .tag--linked,
  .tag--supported {
    color: var(--a-ok);
  }

  .tag--ambiguous,
  .tag--unresolved {
    color: var(--a-warn);
  }

  .tag--contradicted {
    color: var(--a-bad);
  }

  .tag--unmatched {
    color: var(--a-faint);
  }

  .src-count {
    font-size: var(--t-xs);
    color: var(--a-faint);
  }

  .entry details[open] .src-count {
    color: var(--a-accent);
  }

  .sources {
    list-style: none;
    margin: 0 0 8px 54px;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .sources li {
    display: grid;
    gap: 1px;
  }

  .src-who {
    font-size: var(--t-sm);
  }

  .sources code {
    font: 400 0.75rem/1.4 var(--a-mono);
    color: var(--a-faint);
    overflow-wrap: anywhere;
  }

  .amount {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .amount--credit {
    color: var(--a-ok);
  }
</style>
