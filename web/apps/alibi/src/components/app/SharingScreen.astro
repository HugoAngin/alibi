---
/** Sharing history: what was sent, to whom and when. Empty in the foundation. */
---

<section id="sharing" class="screen" aria-labelledby="sharing-title">
  <h1 id="sharing-title">Shared</h1>
  <p class="empty">
    Nothing shared yet. Each package you approve will be listed here with its recipient and expiry.
  </p>
</section>

<style>
  h1 {
    font-size: var(--t-lg);
  }

  .empty {
    color: var(--c-ink-soft);
  }
</style>
