---
import { audiences } from '@/data/product';
---

<section class="audiences" aria-labelledby="audiences-title">
  <h2 id="audiences-title">Who it is for</h2>
  <ul>
    {audiences.map((a) => (
      <li>
        <h3>{a.title}</h3>
        <p>{a.body}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .audiences {
    padding-block: var(--space-xl);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  h3 {
    font-size: var(--t-md);
  }

  p {
    color: var(--c-ink-soft);
  }
</style>
