---
/**
 * The product landing page: island header, the vertical journey through how Alibi works (hero,
 * six chapters and a recap), a way into the case study, and Join.
 * Composition only; copy lives in src/data/product.ts.
 */
import { Show } from '@clerk/astro/components';

import IslandHeader from '@/components/site/IslandHeader.astro';
import Journey from '@/components/site/Journey.astro';
import SiteFooter from '@/components/site/SiteFooter.astro';

interface Props {
  /** The visitor is on a phone but chose the website; offer the way back. */
  offerApp?: boolean;
}

const { offerApp = false } = Astro.props;
---

<IslandHeader />

<main id="main">
  <Journey />

  <section class="simulate s-wrap" aria-labelledby="simulate-title">
    <div class="simulate-card">
      <div>
        <p class="s-eyebrow">Simulate</p>
        <h2 id="simulate-title" class="s-h2">
          Walk through Maya’s case
        </h2>
        <p class="s-lede">
          A student reseller’s bank asks about a £2,160.00 credit. Watch the passport answer it step
          by step, on the real app, from the alert to a second bank’s request.
        </p>
      </div>
      <a class="s-btn s-btn--primary" href="/simulate/">
        Start the simulation
      </a>
    </div>
  </section>

  <section class="join s-wrap" aria-labelledby="join-title">
    <h2 id="join-title" class="join-title">
      Start living with an alibi
    </h2>
    <p class="actions">
      <Show when="signed-out">
        <a class="s-btn s-btn--primary" href="/sign-up/">
          Join
        </a>
        <a class="s-btn s-btn--ghost" href="/sign-in/">
          Sign in
        </a>
      </Show>
      <Show when="signed-in">
        <a class="s-btn s-btn--primary" href="/app/">
          Open your passport
        </a>
      </Show>
    </p>
    {offerApp && (
      <p>
        <a href="/?view=app">Back to the Alibi app</a>
      </p>
    )}
  </section>
</main>

<SiteFooter />

<style>
  .simulate {
    padding-block: var(--s-section) 0;
  }

  .simulate-card {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: var(--s-radius-card);
    background: #fff;
    box-shadow: var(--s-shadow);
  }

  .join {
    padding-block: var(--s-section);
    text-align: center;
  }

  .join-title {
    font: 500 var(--s-t-hero) / 1.04 var(--s-font-display);
    letter-spacing: -0.03em;
    margin: 0 auto 2rem;
    max-width: 16ch;
  }

  .actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
