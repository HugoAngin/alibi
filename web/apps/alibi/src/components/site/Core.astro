---
/**
 * Core: the three things that set Alibi apart, each with its own visual.
 * Copy in src/data/product.ts. The integration visual uses the real shared
 * buttons from packages/ui, so they work from here too. Evidence carries the
 * site's signature: a stamped reference, the record ID and its revision.
 */
import ConnectAlibiButton from '@alibi/ui/ConnectAlibiButton.astro';
import RequestAlibiButton from '@alibi/ui/RequestAlibiButton.astro';

import { core } from '@/data/product';

const origin = Astro.url.origin;
const roles = [
  {
    name: 'Matcher',
    does: 'links the £2,160.00 credit to payout PO-0001-01',
    ref: 'txn-0001-004 r1',
  },
  {
    name: 'Detective',
    does: '“released to seller balance” is not a bank transfer',
    ref: 'rec-0001-020 r1',
  },
  {
    name: 'Challenger',
    does: 'fetches the payout: settled 27 Oct, before the credit',
    ref: 'rec-0001-021 r1',
  },
  { name: 'Curator', does: 'picks 20 records; rent and purchases stay private', ref: '20 records' },
];
const [engine, integrations, control] = core;
---

<section id="core" class="core" aria-labelledby="core-title">
  <div class="s-wrap">
    <header class="core-head">
      <p class="s-eyebrow">Core</p>
      <h2 id="core-title" class="s-h2">
        Three things no statement export can do
      </h2>
    </header>

    <!-- 01 The Alibi engine -->
    <article class="feature" aria-labelledby="f-engine">
      <div class="text">
        <p class="index">{engine.index}</p>
        <p class="s-eyebrow">{engine.eyebrow}</p>
        <h3 id="f-engine">{engine.title}</h3>
        <p class="s-lede">{engine.body}</p>
      </div>
      <div class="visual">
        <ol class="roles">
          {roles.map((r) => (
            <li>
              <span class="role">{r.name}</span>
              <span class="does">{r.does}</span>
              <code class="s-ref">{r.ref}</code>
            </li>
          ))}
        </ol>
        <div class="verdict">
          <span class="check" aria-hidden="true">
            ✓
          </span>
          <div>
            <strong>Supported</strong>
            <span>240000 − 18000 − 6000 = 216000, checked in code</span>
          </div>
        </div>
      </div>
    </article>

    <!-- 02 Merchant and bank integration -->
    <article class="feature feature--flip" id="integrations" aria-labelledby="f-integrations">
      <div class="text">
        <p class="index">{integrations.index}</p>
        <p class="s-eyebrow">{integrations.eyebrow}</p>
        <h3 id="f-integrations">{integrations.title}</h3>
        <p class="s-lede">{integrations.body}</p>
      </div>
      <div class="visual windows">
        <div class="window">
          <p class="chrome">
            <span></span>
            <span></span>
            <span></span> Mock Marketplace · Account settings
          </p>
          <div class="window-body">
            <p class="muted">Connected services</p>
            <ConnectAlibiButton
              alibiOrigin={origin}
              merchantId="mock-marketplace"
              returnTo={`${origin}/#integrations`}
              context="account"
            />
          </div>
        </div>
        <div class="window window--bank">
          <p class="chrome">
            <span></span>
            <span></span>
            <span></span> Bank A · Financial Crime Operations
          </p>
          <div class="window-body">
            <p class="muted">Case FC-0147 · £2,160.00 credit under review</p>
            <RequestAlibiButton href="/simulate/" />
          </div>
        </div>
      </div>
    </article>

    <!-- 03 You stay in control -->
    <article class="feature" aria-labelledby="f-control">
      <div class="text">
        <p class="index">{control.index}</p>
        <p class="s-eyebrow">{control.eyebrow}</p>
        <h3 id="f-control">{control.title}</h3>
        <p class="s-lede">{control.body}</p>
      </div>
      <div class="visual">
        <div class="approval">
          <p class="muted">Your private review · Bank A</p>
          <p class="row">
            <span class="dot dot--ok"></span>
            <span>Sent to Bank A</span>
            <span class="figure">20 records</span>
          </p>
          <p class="row">
            <span class="dot dot--bad"></span>
            <span>Not sent</span>
            <span class="figure">Rent, 2 card payments, a purchase</span>
          </p>
          <p class="row">
            <span class="dot"></span>
            <span>Bank B</span>
            <span class="figure">Needs its own approval</span>
          </p>
          <span class="approve">Approve for Bank A</span>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .core {
    padding-block: var(--s-section);
  }

  .core-head {
    max-width: 44rem;
    margin-bottom: 64px;
  }

  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
    padding-block: 64px;
    border-top: 1px solid var(--s-line);
  }

  .feature--flip .text {
    order: 2;
  }

  .index {
    font: 500 0.875rem/1 var(--s-font-mono);
    color: var(--s-ink-faint);
    margin: 0 0 16px;
  }

  h3 {
    font: 500 var(--s-t-h3) / 1.12 var(--s-font-display);
    letter-spacing: -0.02em;
    margin: 12px 0 16px;
  }

  .muted {
    color: var(--s-ink-faint);
    font-size: 0.875rem;
    margin: 0 0 12px;
  }

  /* Engine */
  .roles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  .roles li {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    min-height: 56px;
    padding: 12px 16px;
    border-radius: 14px;
    border: 1px solid var(--s-line);
    background: var(--s-card);
  }

  .role {
    font: 500 0.9375rem/1.2 var(--s-font-body);
  }

  .does {
    color: var(--s-ink-soft);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .verdict {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 12px;
    padding: 16px;
    border-radius: 14px;
    background: var(--s-ink);
    color: var(--s-paper);
  }

  .verdict div {
    display: grid;
    gap: 4px;
  }

  .verdict strong {
    font-weight: 500;
  }

  .verdict span:not(.check) {
    font: 400 0.8125rem/1.4 var(--s-font-mono);
    font-variant-numeric: tabular-nums;
    color: rgb(247 244 238 / 0.75);
  }

  .check {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--s-ok);
    font-weight: 500;
  }

  /* Integrations */
  .windows {
    display: grid;
    gap: 16px;
  }

  .window {
    border-radius: 16px;
    border: 1px solid var(--s-line);
    background: var(--s-card);
    box-shadow: var(--s-shadow);
    overflow: hidden;
  }

  .window--bank {
    margin-left: 40px;
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 8px 12px;
    font-size: 0.75rem;
    color: var(--s-ink-faint);
    border-bottom: 1px solid var(--s-line);
    background: var(--s-paper-2);
  }

  .chrome span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgb(31 27 22 / 0.14);
  }

  .window-body {
    padding: 20px 20px 24px;
  }

  /* Control */
  .approval {
    display: grid;
    gap: 12px;
    padding: 24px;
    border-radius: var(--s-radius-card);
    border: 1px solid var(--s-line);
    background: var(--s-card);
    box-shadow: var(--s-shadow);
  }

  .row {
    display: grid;
    grid-template-columns: 10px 112px minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    margin: 0;
    padding-block: 8px;
    border-bottom: 1px solid var(--s-line);
    font-size: 0.9375rem;
  }

  .figure {
    color: var(--s-ink-soft);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid var(--s-ink-faint);
  }

  .dot--ok {
    background: var(--s-ok);
    border-color: var(--s-ok);
  }

  .dot--bad {
    border-style: dashed;
    border-color: var(--s-bad);
  }

  .approve {
    justify-self: start;
    margin-top: 8px;
    padding: 12px 20px;
    border-radius: 10px;
    background: var(--s-ink);
    color: var(--s-paper);
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .feature {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-block: 48px;
    }
    .feature--flip .text {
      order: 0;
    }
    .roles li {
      grid-template-columns: 1fr auto;
      gap: 4px 12px;
    }
    .roles .does {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .window--bank {
      margin-left: 0;
    }
    .row {
      grid-template-columns: 10px 1fr;
    }
    .row .figure {
      grid-column: 2;
    }
  }
</style>
