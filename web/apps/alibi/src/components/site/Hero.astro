---
import { Show } from '@clerk/astro/components';

import { product } from '@/data/product';
import HeroScene from './HeroScene.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="fields" aria-hidden="true"></div>
  <div class="s-wrap hero-grid">
    <div class="copy">
      <p class="s-eyebrow" data-reveal>
        Financial passport
      </p>
      <h1 id="hero-title" data-reveal style="--reveal-delay: 80ms">
        Your money’s alibi, ready before anyone asks.
      </h1>
      <p class="s-lede" data-reveal style="--reveal-delay: 160ms">
        {product.lede}
      </p>
      <p class="actions" data-reveal style="--reveal-delay: 240ms">
        <Show when="signed-out">
          <a class="s-btn s-btn--primary" href="/sign-up/">
            Join
          </a>
        </Show>
        <Show when="signed-in">
          <a class="s-btn s-btn--primary" href="/app/">
            Open your passport
          </a>
        </Show>
        <a class="s-btn s-btn--ghost" href="/simulate/">
          Simulate a case
        </a>
      </p>
    </div>
    <div class="visual">
      <HeroScene />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 7rem 4rem;
    overflow: hidden;
  }

  /* Soft colour fields behind everything: the glass header refracts them. */
  .fields {
    position: absolute;
    inset: -10% -10% auto;
    height: 70%;
    background:
      radial-gradient(
        40% 50% at 18% 20%,
        color-mix(in srgb, var(--s-field-a) 45%, transparent),
        transparent 70%
      ),
      radial-gradient(
        35% 45% at 82% 10%,
        color-mix(in srgb, var(--s-field-b) 55%, transparent),
        transparent 70%
      ),
      radial-gradient(
        30% 40% at 55% 0%,
        color-mix(in srgb, var(--s-field-c) 50%, transparent),
        transparent 70%
      );
    filter: blur(20px);
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: 2rem;
    width: 100%;
  }

  h1 {
    font: 800 var(--s-t-hero) / 0.98 var(--s-font-display);
    letter-spacing: -0.045em;
    margin: 0.8rem 0 1.4rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .visual {
    height: min(70vh, 640px);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .visual {
      height: 460px;
    }
  }
</style>
