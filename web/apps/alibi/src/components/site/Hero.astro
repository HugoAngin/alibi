---
/**
 * The hero: what Alibi is, beside Maya's passport with her evidence docking
 * onto it. The copy is always rendered visible; its one entrance is CSS
 * (`.s-enter`), so it never waits on a script.
 */
import { product } from '@/data/product';
import HeroScene from './HeroScene.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="s-wrap hero-grid">
    <div class="copy s-enter">
      <p class="s-eyebrow">Financial passport</p>
      <h1 id="hero-title">{product.tagline}</h1>
      <p class="s-lede">{product.lede}</p>
      <p class="actions">
        <a class="s-btn s-btn--primary" href="/simulate/">
          Simulate a case
        </a>
      </p>
    </div>
    <div class="visual">
      <HeroScene />
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 112px 64px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 48px;
    width: 100%;
  }

  h1 {
    font: 500 var(--s-t-hero) / 1.04 var(--s-font-display);
    letter-spacing: -0.03em;
    margin: 16px 0 24px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .visual {
    height: min(68vh, 600px);
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 96px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .visual {
      height: 440px;
    }
  }
</style>
