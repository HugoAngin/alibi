---
/**
 * The landing hero: Maya's financial passport as a physical folio, the one place that holds
 * everything about her money. Closed, it is a cerulean passport with coloured tabs peeking out of the
 * top. As the visitor scrolls, it turns slowly in 3D and opens: the inside cover is her passport
 * page, and out of the pocket rise her shopping profiles (Amazon, Deliveroo, UNIQLO, UCL) as file
 * dividers and her bank cards (Santander, NatWest).
 *
 * The folio itself is src/components/passport/PassportFolio.astro. The script only writes its pose
 * (turn, open, and each item's rise), and runs only while the hero is on screen. Without JavaScript, or
 * with reduced motion, the folio shows open at a fixed angle and the page scrolls normally.
 *
 * Facts come from case 1 (holder `maya-001`, accounts ••4417 and ••0921, 1,284 records since 2022).
 */
import PassportFolio from '@/components/passport/PassportFolio.astro';
import { FOLIO_TINTS, type FolioContents } from '@/lib/passportFolio';

/** The team, first names, each linking to their GitHub profile. */
const team = [
  { name: 'Arnav', github: 'Knull' },
  { name: 'Hugo', github: 'HugoAngin' },
  { name: 'Elio', github: 'eliohd' },
  { name: 'Mouaad', github: 'sirExile44' },
  { name: 'Tamim', github: 't7acct' },
];

const maya: FolioContents = {
  holder: 'Maya',
  subjectRef: 'maya-001',
  since: '2022',
  profiles: [
    { name: 'UCL', logo: '/logos/ucl.png', role: 'Tuition and refunds', tint: FOLIO_TINTS[0] },
    {
      name: 'UNIQLO',
      logo: '/logos/uniqlo.png',
      role: 'Purchases and refunds',
      tint: FOLIO_TINTS[1],
    },
    {
      name: 'Deliveroo',
      logo: '/logos/deliveroo.png',
      role: 'Rider earnings',
      tint: FOLIO_TINTS[2],
    },
    { name: 'Amazon', logo: '/logos/amazon.png', role: 'Seller payouts', tint: FOLIO_TINTS[3] },
  ],
  featured: {
    role: 'Seller payouts',
    title: 'Amazon seller account',
    stamp: 'signed',
    meta: 'Payout PO-0001-01 · £2,160.00',
  },
  cards: [
    { bank: 'NatWest', logo: '/logos/natwest.png', last4: '0921', kind: 'natwest' },
    { bank: 'Santander', logo: '/logos/santander.png', last4: '4417', kind: 'santander' },
  ],
  facts: [
    { label: 'Merchants', value: '4 connected' },
    { label: 'Banks', value: '2 read-only' },
    { label: 'Shared with', value: 'You decide' },
  ],
  pocket: { title: '1,284 signed records', sub: '4 merchants · 2 banks · since 2022' },
};
---

<header class="pf s-wrap" data-pf>
  <div class="pf-copy s-enter">
    <p class="pf-team">
      Built by{' '}
      {team.map((m, i) => [
        // set:text keeps the link's text free of the whitespace a line break would add.
        <a
          href={`https://github.com/${m.github}`}
          target="_blank"
          rel="noopener noreferrer"
          set:text={m.name}
        />,
        i < team.length - 2 ? ', ' : i === team.length - 2 ? ' and ' : '',
      ])}
    </p>
    <h1 id="journey-title">Your financial passport</h1>
    <p class="pf-lede">
      Alibi gathers the proof behind every payment you receive, from the places that pay you and the
      banks that hold it, so when a bank asks, you answer in minutes.
    </p>
    <p class="pf-actions">
      <a class="s-btn s-btn--primary" href="/simulate/">
        Simulate a case
      </a>
    </p>
  </div>

  <div class="pf-track">
    <div class="pf-sticky">
      <div class="pf-scene">
        <PassportFolio
          {...maya}
          label="Maya’s Alibi financial passport, a cerulean folio that opens to show her passport page, file dividers for her Amazon, Deliveroo, UNIQLO and UCL profiles, and her Santander and NatWest bank cards."
        />
      </div>
    </div>
  </div>
</header>

<style>
  /* ------------------------------------------------------------------ layout */
  .pf {
    /* The folio's pose (--open, --ry, --k, ...) is written here by the script and inherited.
     * Without it, PassportFolio's defaults show the passport open. */
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(24px, 4vw, 64px);
    max-width: 80rem;
  }

  .pf-copy {
    align-self: start;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    min-height: 100vh;
    /* Starts just under the site header, which sits over the top of the hero on wide screens. */
    padding-block: calc(var(--s-head-h) + clamp(20px, 4vh, 64px)) 56px;
  }

  .pf-team {
    align-self: flex-start;
    margin: 0 0 20px;
    padding: 6px 14px;
    border: 1px solid var(--s-line);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.55);
    color: var(--s-ink-soft);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .pf-team a {
    color: var(--s-ink);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgb(31 27 22 / 0.25);
    text-underline-offset: 3px;
  }

  .pf-team a:hover,
  .pf-team a:focus-visible {
    color: var(--s-accent);
    text-decoration-color: currentColor;
  }

  h1 {
    font: 500 clamp(3rem, 1.8rem + 4.4vw, 5.75rem) / 0.98 var(--s-font-display);
    letter-spacing: -0.035em;
    margin: 0 0 24px;
    max-width: 9ch;
  }

  .pf-lede {
    font-size: var(--s-t-lede);
    line-height: 1.5;
    color: var(--s-ink-soft);
    max-width: 34rem;
    margin: 0 0 28px;
  }

  .pf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
  }

  .pf-track {
    position: relative;
  }

  .pf-sticky {
    position: relative;
    height: min(100vh, 860px);
    min-height: 620px;
  }

  .pf-scene {
    position: absolute;
    inset: 0;
  }

  /* Once the script runs, the scene pins while the visitor scrolls past it. */
  .pf.is-armed .pf-copy {
    position: sticky;
    top: 0;
  }

  .pf.is-armed .pf-track {
    height: 230vh;
  }

  .pf.is-armed .pf-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    min-height: 0;
  }

  /* --------------------------------------------------------- small screens */
  @media (max-width: 900px) {
    .pf {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .pf-copy,
    .pf.is-armed .pf-copy {
      position: static;
      min-height: 0;
      padding-block: 24px 0;
    }

    .pf-sticky {
      height: 72vh;
      min-height: 460px;
    }

    .pf-scene {
      inset: 24px 0 0;
    }

    .pf.is-armed .pf-track {
      height: 190vh;
    }

    /* Pinned in the middle of the screen, so the folio peeks under the buttons on load. */
    .pf.is-armed .pf-sticky {
      top: 18svh;
      height: 64svh;
    }

    .pf.is-armed .pf-scene {
      inset: 0;
    }
  }
</style>

<script>
  /*
   * Scroll drives the passport: as the visitor scrolls through the hero, it turns from a tilted,
   * closed folio to an open one facing them, and its contents rise out of the pocket one by one.
   * The scroll position is eased each frame so the motion stays slow and soft, with a faint float
   * on top. Nothing runs while the hero is off screen.
   */
  const root = document.querySelector<HTMLElement>('[data-pf]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const ease = (a: number, b: number, v: number) => {
    const t = clamp((v - a) / (b - a));
    return t * t * (3 - 2 * t);
  };

  if (root && !reduced) {
    const track = root.querySelector<HTMLElement>('.pf-track');
    const scene = root.querySelector<HTMLElement>('.pf-scene');
    const copyTop = root.querySelector<HTMLElement>('.pf-copy h1');
    const copyEnd = root.querySelector<HTMLElement>('.pf-actions');
    const wide = window.matchMedia('(min-width: 901px)');
    const items = [...root.querySelectorAll<HTMLElement>('[data-pf-item]')].map((el) => ({
      el,
      a: Number(el.dataset.a),
      b: Number(el.dataset.b),
    }));

    if (track && scene) {
      root.classList.add('is-armed');

      let target = 0;
      let p = 0;
      let visible = true;
      let raf = 0;
      // Beside the copy on wide screens: how far to pull the closed folio towards the page centre
      // (px) and the vertical offset that centres it on the copy.
      let pull = 0;

      const measure = () => {
        const r = track.getBoundingClientRect();
        const span = r.height - window.innerHeight;
        target = span > 0 ? clamp(-r.top / span) : 0;
      };

      const fit = () => {
        // Room for the open folio (two covers wide, tabs above) inside the scene.
        const k = Math.min(1.08, scene.clientWidth / 620, scene.clientHeight / 600);
        root.style.setProperty('--k', Math.max(0.45, k).toFixed(3));

        // Copy and scene are pinned together, so this offset holds for the whole hero.
        if (wide.matches && copyTop && copyEnd) {
          const s = scene.getBoundingClientRect();
          const mid =
            (copyTop.getBoundingClientRect().top + copyEnd.getBoundingClientRect().bottom) / 2;
          root.style.setProperty('--oy', `${Math.round(mid - (s.top + s.height / 2))}px`);
          pull = s.width * 0.14;
        } else {
          root.style.setProperty('--oy', '24px');
          pull = 0;
        }
      };

      const frame = (now: number) => {
        p += (target - p) * 0.09;
        if (Math.abs(target - p) < 0.0004) p = target;
        const t = now / 1000;

        const open = ease(0.06, 0.56, p);
        root.style.setProperty('--open', open.toFixed(4));
        // Closed, it sits in towards the centre beside the copy; open, it eases back to make room.
        root.style.setProperty('--ox', `${(-pull * lerp(1, 0.35, open)).toFixed(1)}px`);
        root.style.setProperty(
          '--ry',
          `${(lerp(-34, 20, p) + Math.sin(t * 0.5) * 2).toFixed(2)}deg`,
        );
        root.style.setProperty(
          '--rx',
          `${(lerp(20, 11, p) + Math.cos(t * 0.4) * 1.2).toFixed(2)}deg`,
        );
        root.style.setProperty('--rz', `${lerp(-9, -3, p).toFixed(2)}deg`);
        root.style.setProperty('--fy', `${(Math.sin(t * 0.8) * 5).toFixed(2)}px`);

        for (const it of items) it.el.style.setProperty('--t', ease(it.a, it.b, p).toFixed(4));

        raf = visible ? requestAnimationFrame(frame) : 0;
      };

      const start = () => {
        if (!raf) raf = requestAnimationFrame(frame);
      };

      new IntersectionObserver((entries) => {
        visible = entries.some((e) => e.isIntersecting);
        if (visible) start();
      }).observe(root);

      window.addEventListener('alibi:scroll', measure);
      window.addEventListener('scroll', measure, { passive: true });
      const refit = () => {
        fit();
        measure();
      };
      window.addEventListener('resize', refit);
      // The offset that centres the folio on the copy depends on the copy's layout, which changes
      // after first paint on a first visit: the web fonts arrive, images load and the entrance
      // animation settles. Measure again each time, not only once at start.
      document.fonts?.ready.then(refit);
      window.addEventListener('load', refit, { once: true });
      copyTop?.parentElement?.addEventListener('animationend', refit);
      new ResizeObserver(refit).observe(scene);
      if (copyTop?.parentElement) new ResizeObserver(refit).observe(copyTop.parentElement);
      refit();
      p = target;
      start();
    }
  }
</script>
