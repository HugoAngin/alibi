---
/** `/app/account/profile/`: Clerk's profile and security settings for the signed-in holder. */
import { Show, UserProfile } from '@clerk/astro/components';

import BaseLayout from '@/layouts/BaseLayout.astro';
import AppFrame from '@/components/app/AppFrame.astro';
import { clerkAppearance } from '@/lib/clerk';

export const prerender = false;

// The local demo runs without Clerk (demo holder mode), so there is no Clerk profile to manage.
const demo = Astro.locals.demoHolder !== undefined;
---

<BaseLayout title="Profile" view="app">
  <AppFrame active="account">
    <a class="back" href="/app/account/">
      ← Account
    </a>
    {demo ? (
      <p class="lede">This local demo runs without Clerk, so there is no profile to manage here.</p>
    ) : (
      <>
        <Show when="signed-in">
          <div class="profile">
            <UserProfile appearance={clerkAppearance} routing="hash" />
          </div>
        </Show>
        <Show when="signed-out">
          <p class="lede">
            <a href="/sign-in/" target="_top">
              Sign in
            </a>{' '}
            to manage your profile.
          </p>
        </Show>
      </>
    )}
  </AppFrame>
</BaseLayout>

<style>
  .back {
    font-size: var(--t-sm);
    color: var(--a-accent);
    text-decoration: none;
  }

  .profile {
    margin: 16px calc(-1 * var(--gutter)) 0;
    overflow-x: auto;
  }

  .lede {
    margin-top: 16px;
    font-size: var(--t-sm);
  }
</style>
