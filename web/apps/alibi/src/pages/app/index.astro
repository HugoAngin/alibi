---
/**
 * `/app/`: Maya's passport home, on any device. `/` shows the same screen on a
 * phone, and `/phone/` frames it on a desktop. Rendered per request because it
 * reads the backend.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppFrame from '@/components/app/AppFrame.astro';
import PassportHome from '@/components/app/PassportHome.astro';
import { loadPassport } from '@/lib/passport';

export const prerender = false;

const loaded = await loadPassport();
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<BaseLayout title="Passport" view="app">
  {loaded.source === 'missing' ? (
    <AppFrame active="passport">
      <p>{loaded.reason}</p>
    </AppFrame>
  ) : (
    <AppFrame
      active="passport"
      holder={loaded.data.holder.name}
      fixtureReason={loaded.source === 'fixture' ? loaded.reason : undefined}
    >
      <PassportHome data={loaded.data} />
    </AppFrame>
  )}
</BaseLayout>
