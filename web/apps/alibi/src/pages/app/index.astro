---
/**
 * `/app/`: the signed-in holder's dashboard home, on desktop and phone alike (Join and sign-in
 * land here). `/simulate/` shows Maya's, read-only. Rendered per request because it reads the
 * backend.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppFrame from '@/components/app/AppFrame.astro';
import PassportHome from '@/components/app/PassportHome.astro';
import { loadPassport } from '@/lib/passport';

export const prerender = false;

const loaded = await loadPassport();
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<BaseLayout title="Passport" view="app">
  {loaded.source === 'missing' ? (
    <AppFrame active="home" wide>
      <p>{loaded.reason}</p>
    </AppFrame>
  ) : (
    <AppFrame
      active="home"
      wide
      holder={loaded.data.holder.name}
      fixtureReason={loaded.source === 'fixture' ? loaded.reason : undefined}
    >
      <PassportHome data={loaded.data} />
    </AppFrame>
  )}
</BaseLayout>
