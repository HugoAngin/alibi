---
/**
 * `/preview/app/`: Maya's passport home as the public case 1 preview, for the phone frames on
 * `/simulate/` and `/phone/`. Built only from the case 1 fixture: it never reads the backend and
 * offers no action, so it can stay public while `/app/*` needs sign-in. Links into the app are
 * rewritten to their preview pages by the middleware (src/middleware.ts).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppFrame from '@/components/app/AppFrame.astro';
import PassportHome from '@/components/app/PassportHome.astro';
import { passportFixture } from '@/data/fixtures';

export const prerender = false;

const data = passportFixture();
---

<BaseLayout title="Passport preview" view="app">
  <AppFrame
    active="home"
    holder={data.holder.name}
    fixtureReason="A read-only preview of Maya's case. Sign in to use your own passport."
  >
    <PassportHome data={data} offline />
  </AppFrame>
</BaseLayout>
