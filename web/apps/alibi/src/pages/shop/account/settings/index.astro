---
/** Maya's account: profile, connected services ("Connect to my Alibi") and her sales. */
import ShopLayout from '@/shop/layouts/ShopLayout.astro';
import AlibiConnection from '@/shop/components/AlibiConnection.astro';
import SellerNav from '@/shop/components/SellerNav.astro';
import { formatGBP, sales, seller, shop } from '@/shop/data/shop';
---

<ShopLayout title="Account settings">
  <h1>Account</h1>
  <SellerNav current="settings" />

  <div class="cols">
    <section aria-labelledby="profile-title" class="panel">
      <h2 id="profile-title">Profile</h2>
      <div class="profile">
        <span class="avatar" aria-hidden="true">
          {seller.name.charAt(0)}
        </span>
        <span>
          <strong>{seller.name}</strong>
          <br />
          <span class="muted">
            @{seller.name.toLowerCase()} · seller ID <code>{seller.subjectRef}</code>
          </span>
        </span>
      </div>
    </section>

    <section aria-labelledby="connected-title" class="panel">
      <h2 id="connected-title">Connected services</h2>
      <AlibiConnection
        context="account"
        returnPath="/shop/account/settings/"
        heading="Alibi"
        pitch={`Keep a verified copy of your ${shop.name} sales, refunds, fees and payouts in your Alibi passport, so you can explain payments to your bank.`}
        connected={`Your ${shop.name} sales, refunds, fees and payouts now go to your Alibi passport.`}
        viewLink
      />
    </section>
  </div>

  <section aria-labelledby="sales-title" class="panel">
    <h2 id="sales-title">Your sales</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Sold</th>
            <th scope="col">Order</th>
            <th scope="col">Item</th>
            <th scope="col" class="num">
              Price
            </th>
          </tr>
        </thead>
        <tbody>
          {sales.map((s) => (
            <tr>
              <td>{s.soldOn}</td>
              <td>
                <code>{s.reference}</code>
              </td>
              <td>{s.title}</td>
              <td class="num">{formatGBP(s.priceMinor)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</ShopLayout>

<style>
  h1 {
    font-size: var(--t-lg);
    letter-spacing: -0.02em;
  }

  .cols {
    display: grid;
    gap: 0 var(--space-md);
  }

  @media (min-width: 820px) {
    .cols {
      grid-template-columns: 1fr 1.4fr;
    }
  }

  .panel {
    margin-bottom: var(--space-md);
    padding: var(--space-md);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-md);
  }

  h2 {
    font-size: var(--t-md);
  }

  .profile {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    line-height: 1.4;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--c-soft);
    font-weight: 700;
    font-size: var(--t-md);
  }

  .muted {
    color: var(--c-ink-faint);
    font-size: var(--t-sm);
  }

  .table-wrap {
    overflow-x: auto;
  }

  th {
    font-size: var(--t-sm);
    color: var(--c-ink-soft);
    font-weight: 500;
  }

  td:first-child,
  td code,
  .num {
    white-space: nowrap;
  }

  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
</style>
