---
/**
 * Shop front: items for sale (synthetic listings), filtered by category or a
 * search, and a row of recently sold items, which are Maya's case 1 sales.
 */
import ShopLayout from '@/shop/layouts/ShopLayout.astro';
import ProductCard from '@/shop/components/ProductCard.astro';
import { categories, listings, sales, seller, shop } from '@/shop/data/shop';

const q = (Astro.url.searchParams.get('q') ?? '').trim();
const c = Astro.url.searchParams.get('c');
const category = categories.find((x) => x.id === c);

const needle = q.toLowerCase();
const shown = listings.filter(
  (l) =>
    (!category || l.category === category.id) &&
    (!needle || `${l.title} ${l.category} ${l.seller}`.toLowerCase().includes(needle)),
);
const heading = q ? `Results for “${q}”` : category ? category.label : 'New in';
const filtered = Boolean(q || category);
---

<ShopLayout title={category?.label ?? (q ? `Search: ${q}` : undefined)}>
  {!filtered && (
    <section class="hero">
      <h1>{shop.tagline}</h1>
      <p>
        Every order is covered by buyer protection. Pay at checkout, collect your receipt, done.
      </p>
      <a class="promo" href="/shop/account/settings/">
        <span class="new">New</span> Keep every receipt in your Alibi
        <span aria-hidden="true">→</span>
      </a>
    </section>
  )}

  <section aria-labelledby="grid-title">
    <div class="head">
      <h2 id="grid-title">{heading}</h2>
      <span class="count">
        {shown.length} {shown.length === 1 ? 'item' : 'items'}
      </span>
    </div>
    {shown.length ? (
      <ul class="grid">
        {shown.map((l) => (
          <li>
            <ProductCard
              href={`/shop/item/${l.id}/`}
              title={l.title}
              priceMinor={l.priceMinor}
              meta={`${l.size} · ${l.condition}`}
              art={l.art}
              tone={l.tone}
            />
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">
        Nothing matches yet. <a href="/shop/">See everything</a>
      </p>
    )}
  </section>

  {!filtered && (
    <section aria-labelledby="sold-title" class="sold">
      <div class="head">
        <h2 id="sold-title">Recently sold by @{seller.name.toLowerCase()}</h2>
        <a href="/shop/seller/">Seller hub</a>
      </div>
      <ul class="grid">
        {sales.map((s) => (
          <li>
            <ProductCard
              title={s.title}
              priceMinor={s.priceMinor}
              meta={`Sold ${new Date(s.soldOn).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}`}
              art={s.art}
              badge="Sold"
            />
          </li>
        ))}
      </ul>
    </section>
  )}
</ShopLayout>

<style>
  .hero {
    padding: var(--space-lg) 0 var(--space-xl);
    max-width: 40rem;
  }

  .hero h1 {
    font-size: var(--t-xl);
    font-weight: 750;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-bottom: var(--space-sm);
  }

  .hero p {
    color: var(--c-ink-soft);
    font-size: var(--t-md);
  }

  .promo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem 0.35rem 0.35rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-pill);
    font-size: var(--t-sm);
    text-decoration: none;
  }

  .promo:hover {
    border-color: var(--c-ink);
  }

  .new {
    padding: 0.1rem 0.55rem;
    border-radius: var(--radius-pill);
    background: var(--c-ink);
    color: #fff;
    font-size: var(--t-xs);
    font-weight: 600;
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .head h2 {
    font-size: var(--t-md);
    margin: 0;
  }

  .head .count,
  .head a {
    font-size: var(--t-sm);
    color: var(--c-ink-soft);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-lg) var(--space-sm);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .sold {
    margin-top: var(--space-2xl);
  }

  .empty {
    padding: var(--space-xl) 0;
    color: var(--c-ink-soft);
  }
</style>
