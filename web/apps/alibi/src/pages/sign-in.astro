---
/**
 * `/sign-in/`: there are no Alibi accounts in this build. The local live demo signs in as Maya at
 * /demo-sign-in/; everywhere else the visitor goes to Maya's simulated dashboard.
 */
export const prerender = false;

return Astro.redirect(Astro.locals.demoHolder !== undefined ? '/demo-sign-in/' : '/simulate/', 303);
---
