---
/**
 * `/simulate/`: Maya's case, step by step, beside the real app in a phone
 * frame. As each step scrolls into view, the phone moves to the screen it
 * describes. The app reads the live backend when one is connected, and
 * otherwise shows the built-in case 1 data and says so.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import IslandHeader from '@/components/site/IslandHeader.astro';
import SiteFooter from '@/components/site/SiteFooter.astro';
import PhoneFrame from '@/components/PhoneFrame.astro';

const steps = [
  {
    screen: '/app/',
    title: 'Maya’s history builds itself',
    body: 'Maya resells clothes on a marketplace. She connected it and her bank once. Every sale, refund, fee and payout has flowed into her passport since, signed by the marketplace.',
  },
  {
    screen: '/app/',
    title: 'An alert, before anyone asks',
    body: 'On 28 Oct a £2,160 credit lands. The marketplace only said the money was “released to her seller balance”, which is not proof it reached her bank. Alibi flags the gap straight away.',
  },
  {
    screen: '/app/requests/rfc-0001-01/',
    title: 'Bank A asks',
    body: 'On 2 Nov Bank A restricts her account and asks two questions: where did the £2,160 come from, and how is it made up? Rent is due.',
  },
  {
    screen: '/app/requests/rfc-0001-01/#step-sof',
    title: 'The engine investigates',
    body: 'The Challenger reads the marketplace message, spots withdrawal PO-0001-01 and fetches it: settled 27 Oct, the day before the credit. Code checks the reference, the timing and 240000 − 18000 − 6000 = 216000.',
  },
  {
    screen: '/app/requests/rfc-0001-01/#review-title',
    title: 'Maya decides what is shared',
    body: 'Twenty records answer the questions. Her rent, two card payments and a purchase stay private. She approves the exact package for Bank A, and only Bank A.',
  },
  {
    screen: '/app/requests/rfc-0001-02/',
    title: 'Bank B asks something else',
    body: 'Two days later Bank B asks for her October sales and refunds. The same passport answers from the same records, with no new upload, and Maya approves this one separately.',
  },
];
---

<BaseLayout title="Simulate" description="Maya’s case, step by step, on the real Alibi app.">
  <IslandHeader current="simulate" />
  <main id="main" class="s-wrap sim">
    <header class="intro" data-reveal>
      <p class="s-eyebrow">Simulate</p>
      <h1 class="s-h2">Maya’s £2,160, from alert to answer.</h1>
      <p class="s-lede">
        Scroll the story. The phone shows the real app at each step. Every record is synthetic.
      </p>
    </header>

    <div class="layout">
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step" data-screen={s.screen} data-reveal>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <h2>{s.title}</h2>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
      <div class="phone" data-sim-phone>
        <PhoneFrame src={steps[0].screen} title="The Alibi app, as Maya sees it on her phone" />
        <p class="hint">
          <a href="/app/">Open the app full screen</a>
        </p>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .sim {
    padding-top: 8rem;
  }

  .intro {
    max-width: 44rem;
    margin-bottom: 3rem;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0 0 40vh;
  }

  .step {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 30rem;
    opacity: 0.35;
    transition: opacity 0.4s;
  }

  .step.is-current {
    opacity: 1;
  }

  .n {
    font: 700 0.9rem/1 var(--s-font-display);
    color: var(--s-accent);
  }

  .step h2 {
    font: 700 clamp(1.5rem, 1.1rem + 1.4vw, 2.2rem) / 1.1 var(--s-font-display);
    letter-spacing: -0.03em;
    margin: 0.6rem 0 0.8rem;
  }

  .step p {
    color: var(--s-ink-soft);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .phone {
    position: sticky;
    top: 6rem;
    align-self: start;
  }

  .hint {
    text-align: center;
    font-size: 0.85rem;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .phone {
      position: relative;
      top: 0;
      order: -1;
    }
    .step {
      min-height: auto;
      padding-block: 2rem;
      opacity: 1;
    }
  }
</style>

<script>
  const frame = document.querySelector<HTMLIFrameElement>('[data-sim-phone] iframe');
  const steps = document.querySelectorAll<HTMLElement>('.step[data-screen]');
  let current = '';

  const show = (step: HTMLElement) => {
    steps.forEach((s) => s.classList.toggle('is-current', s === step));
    const screen = step.dataset.screen!;
    if (!frame || screen === current) return;
    current = screen;
    frame.src = screen;
  };

  const watch = new IntersectionObserver(
    (entries) => {
      const hit = entries
        .filter((e) => e.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (hit) show(hit.target as HTMLElement);
    },
    { rootMargin: '-40% 0px -40% 0px', threshold: [0, 0.25, 0.5] },
  );
  steps.forEach((s) => watch.observe(s));
  if (steps[0]) show(steps[0]);
</script>
