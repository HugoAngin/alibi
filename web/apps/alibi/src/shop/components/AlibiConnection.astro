---
/**
 * The shop's Alibi block: "Connect to my Alibi" when not connected, and a
 * connected state with the holder's first name once Alibi says yes.
 *
 * The button opens Alibi's consent screen in a popup (sign in, approve), and
 * the outcome arrives as an `alibi:connect` event without leaving the page. If
 * popups are blocked it is a normal redirect, and the outcome arrives on the
 * return URL (`?alibi=connected&alibi_name=…`) instead. Either way the shop
 * remembers it in a cookie (lib/alibi.ts), so every page renders the state.
 */
import ConnectAlibiButton from '@alibi/ui/ConnectAlibiButton.astro';
import Logomark from '@alibi/ui/Logomark.astro';
import type { ConnectContext } from '@alibi/ui/links';

import { shop } from '@/shop/data/shop';
import { ALIBI_COOKIE, parseAlibiLink } from '@/shop/lib/alibi';

interface Props {
  context: ConnectContext;
  /** Path on this shop to come back to after a redirect. */
  returnPath: string;
  heading: string;
  /** Shown while not connected. */
  pitch: string;
  /** Shown once connected. */
  connected: string;
  /** Add a "View in Alibi" link to the connected state. */
  viewLink?: boolean;
}

const { context, returnPath, heading, pitch, connected, viewLink = false } = Astro.props;
const link = parseAlibiLink(Astro.cookies.get(ALIBI_COOKIE)?.value);
// Alibi is the same site (the shop lives under /shop/), so both addresses share this origin.
const returnTo = new URL(returnPath, Astro.url).toString();
const alibiOrigin = Astro.url.origin;
---

<div class="alibi-box" data-alibi-box data-state={link ? 'connected' : 'disconnected'}>
  <div class="off">
    <div class="row">
      <span class="tile" aria-hidden="true">
        <Logomark height="0.95rem" decorative />
      </span>
      <div>
        <p class="title">{heading}</p>
        <p class="body">{pitch}</p>
      </div>
    </div>
    <ConnectAlibiButton
      alibiOrigin={alibiOrigin}
      merchantId={shop.merchantId}
      returnTo={returnTo}
      context={context}
      display="popup"
    />
    <p class="note" data-alibi-declined hidden role="status">
      Not connected. You can connect any time.
    </p>
  </div>

  <div class="on" role="status">
    <div class="row">
      <span class="tile ok" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12.5l4.5 4.5L19 7.5" />
        </svg>
      </span>
      <div>
        <p class="title">
          Connected to <Logomark height="0.95em" />
          <span data-alibi-name>{link?.name ? `as ${link.name}` : ''}</span>
        </p>
        <p class="body">{connected}</p>
        <p class="links">
          {viewLink && <a href="/app/">View in Alibi</a>}
          <button type="button" class="disconnect" data-alibi-disconnect>
            Disconnect
          </button>
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  import { ALIBI_COOKIE, serializeAlibiLink, type AlibiLink } from '@/shop/lib/alibi';
  import type { ConnectMessage } from '@alibi/ui/links';

  const boxes = document.querySelectorAll<HTMLElement>('[data-alibi-box]');

  function show(link: AlibiLink | null) {
    for (const box of boxes) {
      box.dataset.state = link ? 'connected' : 'disconnected';
      const name = box.querySelector<HTMLElement>('[data-alibi-name]');
      if (name) name.textContent = link?.name ? `as ${link.name}` : '';
      const declined = box.querySelector<HTMLElement>('[data-alibi-declined]');
      if (declined) declined.hidden = true;
    }
  }

  function remember(link: AlibiLink | null) {
    const value = link ? serializeAlibiLink(link) : '';
    const age = link ? 60 * 60 * 24 * 365 : 0;
    document.cookie = `${ALIBI_COOKIE}=${value}; path=/; max-age=${age}; samesite=lax`;
  }

  function connected(name: string | undefined) {
    const link = { name: name ?? '', connectedAt: new Date().toISOString() };
    remember(link);
    show(link);
    for (const box of boxes) {
      box.dataset.justConnected = '';
      window.setTimeout(() => delete box.dataset.justConnected, 1600);
    }
  }

  function declined() {
    for (const box of boxes) {
      const note = box.querySelector<HTMLElement>('[data-alibi-declined]');
      if (note && box.dataset.state === 'disconnected') note.hidden = false;
    }
  }

  // Popup: the outcome arrives as an event from ConnectAlibiButton.
  document.addEventListener('alibi:connect', (event) => {
    const detail = (event as CustomEvent<ConnectMessage>).detail;
    if (detail.outcome === 'connected') connected(detail.name);
    else declined();
  });

  // Redirect: the outcome arrives on the URL. Read it once, then tidy the URL.
  const url = new URL(window.location.href);
  const outcome = url.searchParams.get('alibi');
  if (outcome) {
    if (outcome === 'connected') connected(url.searchParams.get('alibi_name') ?? undefined);
    if (outcome === 'declined') declined();
    url.searchParams.delete('alibi');
    url.searchParams.delete('alibi_name');
    history.replaceState(null, '', url);
  }

  for (const button of document.querySelectorAll('[data-alibi-disconnect]')) {
    button.addEventListener('click', () => {
      remember(null);
      show(null);
    });
  }
</script>

<style>
  .alibi-box {
    padding: var(--space-sm);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-md);
    background: #fff;
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .alibi-box[data-state='connected'] .off,
  .alibi-box[data-state='disconnected'] .on {
    display: none;
  }

  .alibi-box[data-just-connected] {
    border-color: var(--c-ok);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--c-ok) 14%, transparent);
  }

  .row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
  }

  .off .row {
    margin-bottom: var(--space-xs);
  }

  /* Line the button up with the text, so the shop's own Pay stays the main action. */
  .off {
    --indent: calc(2.5rem + var(--space-xs));
  }

  .off > :global(.alibi-connect),
  .note {
    margin-left: var(--indent);
  }

  @media (max-width: 480px) {
    .off > :global(.alibi-connect) {
      display: flex;
      margin-left: 0;
    }
  }

  .tile {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    background: var(--c-alibi);
    color: var(--c-alibi-ink);
  }

  .tile.ok {
    background: color-mix(in srgb, var(--c-ok) 12%, white);
    color: var(--c-ok);
  }

  .title {
    margin: 0;
    font-weight: 650;
  }

  .body {
    margin: 0.15rem 0 0;
    font-size: var(--t-sm);
    color: var(--c-ink-soft);
  }

  .note {
    margin: var(--space-2xs) 0 0;
    font-size: var(--t-sm);
    color: var(--c-ink-soft);
  }

  .links {
    display: flex;
    gap: var(--space-sm);
    margin: var(--space-2xs) 0 0;
    font-size: var(--t-sm);
  }

  .links a {
    color: var(--c-ink);
    font-weight: 550;
  }

  .disconnect {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: var(--t-sm);
    color: var(--c-ink-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
</style>
