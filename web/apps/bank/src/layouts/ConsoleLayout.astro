---
/**
 * Shell for the simulated bank console: dense, internal-tool styling that
 * overrides the shared tokens. The Alibi button keeps Alibi's colours, as an
 * integrated third-party action would.
 */
import '@alibi/ui/base.css';

import { analyst, bank } from '@/data/cases';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} · ${bank.name} ${bank.unit}` : `${bank.name} ${bank.unit}`;
import ReplayBanner from '@alibi/ui/ReplayBanner.astro';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <ReplayBanner />
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <p class="simulated">Simulated bank system for the Alibi demo. Synthetic data only.</p>
    <header class="console-header">
      <a class="console-name" href="/">
        {bank.name} · {bank.unit}
      </a>
      <nav aria-label="Console">
        <a href="/">Cases</a>
        <a href="/inbox/">Alibi inbox</a>
        <a href="/sign-in/">Sign in</a>
      </nav>
      <span>Signed in as {analyst.name}</span>
    </header>
    <main id="main" class="console-main">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --c-bg: #eef0f3;
    --c-console: #2b3440;
    --t-base: 0.9375rem;
  }
</style>

<style>
  .console-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--gutter);
    background: var(--c-console);
    color: var(--c-surface);
    font-size: var(--t-sm);
  }

  .console-name {
    font-weight: 700;
    text-decoration: none;
  }

  .console-header nav {
    display: flex;
    gap: var(--space-sm);
  }

  .console-main {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-md) var(--gutter) var(--space-2xl);
  }
</style>
