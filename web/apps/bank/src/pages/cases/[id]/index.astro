---
/** The case queue with one case's panel open. Same screen as /, rendered with the panel in place. */
import CaseQueue from '@/components/CaseQueue.astro';
import ConsoleLayout from '@/layouts/ConsoleLayout.astro';
import { findCase } from '@/data/cases';
import { loadQueue } from '@/lib/queue';

export const prerender = false;

const fraudCase = findCase(Astro.params.id);
if (!fraudCase) return new Response('Case not found', { status: 404 });

const loaded = await loadQueue(Astro.cookies);
if ('redirect' in loaded) return Astro.redirect(loaded.redirect, 303);
// In the live demo Maya's case only exists once her payout is flagged (src/lib/queue.ts).
if (!loaded.queue.cases.some((c) => c.id === fraudCase.id)) return Astro.redirect('/', 303);
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<ConsoleLayout title={`Case ${fraudCase.id}`} section="cases" wide>
  <CaseQueue queue={loaded.queue} openId={fraudCase.id} />
</ConsoleLayout>
