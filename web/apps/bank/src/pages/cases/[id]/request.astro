---
/**
 * "Request customer's Alibi": the panel's review step. It shows exactly what will be asked (the
 * case's own request, from data's case file), what it is about, the reply deadline and who sees
 * the answer, then one Send. The form names only the case; /act/ picks the request ID on the
 * server and posts it to the bank service's /rfc. The audience is never a form field: the backend
 * takes it from the bank's credential (execution SP-20, SP-24).
 */
import CaseQueue from '@/components/CaseQueue.astro';
import ConsoleLayout from '@/layouts/ConsoleLayout.astro';
import { findCase } from '@/data/cases';
import { loadQueue } from '@/lib/queue';

export const prerender = false;

const fraudCase = findCase(Astro.params.id);
if (!fraudCase) return new Response('Case not found', { status: 404 });

const loaded = await loadQueue(Astro.cookies);
if ('redirect' in loaded) return Astro.redirect(loaded.redirect, 303);
// Only a case that can still be asked has a request step.
if (loaded.queue.states[fraudCase.id]?.kind !== 'not_requested')
  return Astro.redirect(`/cases/${fraudCase.id}/`, 303);
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<ConsoleLayout title={`Request Alibi · ${fraudCase.id}`} section="cases" wide>
  <CaseQueue queue={loaded.queue} openId={fraudCase.id} step="request" />
</ConsoleLayout>
