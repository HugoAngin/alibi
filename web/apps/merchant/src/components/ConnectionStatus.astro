---
/**
 * Shows the outcome Alibi sent the customer back with (`?alibi=connected` or
 * `?alibi=declined`). The page is static, so this reads the query string in
 * the browser; a real merchant would read its own stored connection instead.
 */
---

<p class="connection-status" data-connection-status hidden></p>

<script>
  const el = document.querySelector<HTMLElement>('[data-connection-status]');
  const outcome = new URLSearchParams(window.location.search).get('alibi');
  const messages: Record<string, string> = {
    connected: 'Connected. Your sales, refunds, fees and payouts will appear in your Alibi.',
    declined: 'Not connected. You can connect any time.',
  };
  if (el && outcome && messages[outcome]) {
    el.textContent = messages[outcome];
    el.dataset.outcome = outcome;
    el.hidden = false;
  }
</script>

<style>
  .connection-status {
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    border: 1px solid var(--c-line);
    background: var(--c-surface);
  }

  .connection-status[data-outcome='connected'] {
    border-color: var(--c-ok);
  }
</style>
