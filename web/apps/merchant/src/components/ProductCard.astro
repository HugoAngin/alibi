---
/** A product in the grid: picture, title, size and price. */
import ProductArt from '@/components/ProductArt.astro';
import { formatGBP, type ArtKind } from '@/data/shop';

interface Props {
  href?: string;
  title: string;
  priceMinor: number;
  meta: string;
  art: ArtKind;
  tone?: string;
  /** Shown over the picture, e.g. "Sold". */
  badge?: string;
}

const { href, title, priceMinor, meta, art, tone, badge } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class:list={['card', { sold: Boolean(badge) }]} href={href}>
  <span class="pic">
    <ProductArt kind={art} tone={tone} />
    {badge && <span class="badge">{badge}</span>}
  </span>
  <span class="price">{formatGBP(priceMinor)}</span>
  <span class="title">{title}</span>
  <span class="meta">{meta}</span>
</Tag>

<style>
  .card {
    display: grid;
    gap: 0.1rem;
    color: inherit;
    text-decoration: none;
  }

  .pic {
    position: relative;
    display: block;
    margin-bottom: var(--space-2xs);
  }

  a.card:hover :global(svg) {
    transform: scale(1.04);
  }

  a.card:hover .title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .badge {
    position: absolute;
    left: var(--space-2xs);
    top: var(--space-2xs);
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.92);
    font-size: var(--t-xs);
    font-weight: 600;
  }

  .price {
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  .title {
    font-size: var(--t-sm);
  }

  .meta {
    font-size: var(--t-xs);
    color: var(--c-ink-faint);
  }

  .sold .price {
    color: var(--c-ink-soft);
  }
</style>
