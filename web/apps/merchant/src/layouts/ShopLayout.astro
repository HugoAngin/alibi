---
/**
 * Shell for the simulated marketplace. It overrides a few shared tokens so the
 * shop looks like someone else's product; the Alibi button keeps Alibi's
 * colours, as an embedded third-party button would.
 */
import '@alibi/ui/base.css';

import { shop } from '@/data/shop';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} · ${shop.name}` : shop.name;
const nav = [
  { href: '/', label: 'Shop' },
  { href: '/checkout/', label: 'Basket' },
  { href: '/seller/', label: 'Seller hub' },
  { href: '/account/settings/', label: 'Account' },
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <p class="simulated">Simulated marketplace for the Alibi demo. Synthetic data only.</p>
    <header class="shop-header">
      <a class="shop-name" href="/">
        {shop.name}
      </a>
      <nav aria-label="Shop">
        {nav.map((n) => (
          <a href={n.href}>{n.label}</a>
        ))}
      </nav>
    </header>
    <main id="main" class="shop-main">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --c-bg: #fbf8f4;
    --c-shop: #b5462f;
  }
</style>

<style>
  .shop-header,
  .shop-main {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .shop-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--c-line);
  }

  .shop-name {
    font-size: var(--t-md);
    font-weight: 800;
    color: var(--c-shop);
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: var(--space-sm);
  }

  .shop-main {
    padding-block: var(--space-lg) var(--space-2xl);
  }
</style>
