---
/**
 * The basket. GET shows it; POST changes it (`action` add, buy or remove, and
 * the listing `id`) and redirects, so it works without JavaScript.
 */
import ShopLayout from '@/layouts/ShopLayout.astro';
import ProductArt from '@/components/ProductArt.astro';
import { formatGBP } from '@/data/shop';
import {
  BASKET_COOKIE,
  addToBasket,
  parseBasket,
  priceBasket,
  removeFromBasket,
  serializeBasket,
} from '@/lib/basket';

const cookieOptions = { path: '/', sameSite: 'lax', maxAge: 60 * 60 * 24 * 30 } as const;
let ids = parseBasket(Astro.cookies.get(BASKET_COOKIE)?.value);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const id = String(form.get('id') ?? '');
  ids = action === 'remove' ? removeFromBasket(ids, id) : addToBasket(ids, id);
  Astro.cookies.set(BASKET_COOKIE, serializeBasket(ids), cookieOptions);
  return Astro.redirect(action === 'buy' ? '/checkout/' : '/basket/', 303);
}

const priced = priceBasket(ids);
---

<ShopLayout title="Basket">
  <h1>Basket</h1>

  {priced.items.length === 0 ? (
    <div class="empty">
      <p>Your basket is empty.</p>
      <a class="btn" href="/">
        Start shopping
      </a>
    </div>
  ) : (
    <div class="layout">
      <ul class="lines">
        {priced.items.map((l) => (
          <li>
            <a class="thumb" href={`/item/${l.id}/`}>
              <ProductArt kind={l.art} tone={l.tone} small />
            </a>
            <span class="what">
              <a href={`/item/${l.id}/`}>{l.title}</a>
              <span class="muted">
                {l.size} · {l.condition} · @{l.seller}
              </span>
            </span>
            <span class="price">{formatGBP(l.priceMinor)}</span>
            <form method="post" class="remove">
              <input type="hidden" name="id" value={l.id} />
              <button name="action" value="remove" aria-label={`Remove ${l.title}`}>
                Remove
              </button>
            </form>
          </li>
        ))}
      </ul>

      <aside class="summary" aria-labelledby="summary-title">
        <h2 id="summary-title">Summary</h2>
        <dl>
          <div>
            <dt>Items ({priced.items.length})</dt>
            <dd>{formatGBP(priced.subtotalMinor)}</dd>
          </div>
          <div>
            <dt>Buyer protection</dt>
            <dd>{formatGBP(priced.protectionMinor)}</dd>
          </div>
          <div>
            <dt>Delivery</dt>
            <dd class="muted">At checkout</dd>
          </div>
          <div class="total">
            <dt>Total</dt>
            <dd>{formatGBP(priced.totalMinor)}</dd>
          </div>
        </dl>
        <a class="btn wide" href="/checkout/">
          Checkout
        </a>
        <a class="keep" href="/">
          Continue shopping
        </a>
      </aside>
    </div>
  )}
</ShopLayout>

<style>
  h1 {
    font-size: var(--t-lg);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-md);
  }

  .empty {
    padding: var(--space-xl) 0;
    color: var(--c-ink-soft);
  }

  .layout {
    display: grid;
    gap: var(--space-lg);
  }

  @media (min-width: 860px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 22rem;
      align-items: start;
    }
  }

  .lines {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--c-line);
  }

  .lines li {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    gap: 0.25rem var(--space-sm);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--c-line);
  }

  .thumb {
    grid-row: 1 / span 2;
  }

  .what {
    display: grid;
    line-height: 1.35;
  }

  .what a {
    text-decoration: none;
    font-weight: 550;
  }

  .what a:hover {
    text-decoration: underline;
  }

  .muted {
    color: var(--c-ink-faint);
    font-size: var(--t-sm);
  }

  .price {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .remove {
    grid-column: 2;
    align-self: end;
  }

  .remove button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: var(--t-sm);
    color: var(--c-ink-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .summary {
    padding: var(--space-md);
    background: var(--c-soft);
    border-radius: var(--radius-md);
  }

  @media (min-width: 860px) {
    .summary {
      position: sticky;
      top: 140px;
    }
  }

  .summary h2 {
    font-size: var(--t-md);
  }

  dl {
    margin: 0 0 var(--space-md);
  }

  dl > div {
    display: flex;
    justify-content: space-between;
    padding: 0.3rem 0;
    font-size: var(--t-sm);
  }

  dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  dl > .total {
    margin-top: var(--space-2xs);
    padding-top: var(--space-xs);
    border-top: 1px solid var(--c-line);
    font-size: var(--t-base);
    font-weight: 700;
  }

  .keep {
    display: block;
    margin-top: var(--space-sm);
    text-align: center;
    font-size: var(--t-sm);
    color: var(--c-ink-soft);
  }
</style>
