---
/** Shop front: Maya's lots, all sold in October (case 1's order confirmations). */
import ShopLayout from '@/layouts/ShopLayout.astro';
import { formatGBP, sales, seller, shop } from '@/data/shop';
---

<ShopLayout>
  <h1>{shop.tagline}</h1>
  <p class="lede">{seller.name}’s shop</p>
  <ul class="grid">
    {sales.map((s) => (
      <li>
        <div class="photo" aria-hidden="true" />
        <h2>{s.title}</h2>
        <p>
          {formatGBP(s.priceMinor)} · <span class="sold">Sold {s.soldOn}</span>
        </p>
      </li>
    ))}
  </ul>
</ShopLayout>

<style>
  h1 {
    font-size: var(--t-lg);
  }

  .lede {
    color: var(--c-ink-soft);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
  }

  li {
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-md);
    padding: var(--space-sm);
  }

  .photo {
    aspect-ratio: 4 / 3;
    background: var(--c-line);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-xs);
  }

  h2 {
    font-size: var(--t-base);
  }

  .sold {
    color: var(--c-ink-faint);
    font-size: var(--t-sm);
  }
</style>
