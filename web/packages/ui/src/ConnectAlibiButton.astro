---
/**
 * "Connect to my Alibi". The button a merchant places in a customer's account
 * settings, or at checkout, to link their records to the customer's Alibi
 * passport. It is a link to Alibi's consent page: the merchant never sees the
 * passport, and nothing connects until the holder signs in and approves there.
 *
 * With `display="popup"` the consent page opens in a small window over the
 * merchant's page (like a wallet button), so a checkout is not lost. The
 * outcome comes back by `postMessage` and is re-dispatched on `document` as an
 * `alibi:connect` CustomEvent whose `detail` is a ConnectMessage (links.ts).
 * If the browser blocks the window, the link is followed as a normal redirect
 * and the outcome comes back on the return URL instead.
 */
import Logomark from './Logomark.astro';
import { connectUrl, type ConnectContext, type ConnectDisplay } from './links';

interface Props {
  alibiOrigin: string;
  merchantId: string;
  /** Absolute URL to come back to after the holder decides. */
  returnTo: string;
  context: ConnectContext;
  display?: ConnectDisplay;
  /** Stretch to the width of its container. */
  block?: boolean;
}

const { display = 'page', block = false, ...request } = Astro.props;
const href = connectUrl({ ...request, display: 'page' });
const popupHref = display === 'popup' ? connectUrl({ ...request, display: 'popup' }) : undefined;
const origin = new URL(request.alibiOrigin).origin;
---

<a
  class:list={['alibi-connect', { block }]}
  href={href}
  data-alibi-connect
  data-popup-href={popupHref}
  data-alibi-origin={origin}
>
  <span class="label">Connect to my</span>
  <Logomark height="1.15em" />
  <span class="waiting" aria-hidden="true">
    Continue in the Alibi window…
  </span>
</a>

<script>
  import { isConnectMessage } from './links';

  const buttons = document.querySelectorAll<HTMLAnchorElement>('[data-alibi-connect]');
  const origins = new Set<string>();

  for (const button of buttons) {
    const origin = button.dataset.alibiOrigin;
    if (origin) origins.add(origin);
    const popupHref = button.dataset.popupHref;
    if (!popupHref) continue;

    button.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      const w = 440;
      const h = 720;
      const left = Math.round(window.screenX + (window.outerWidth - w) / 2);
      const top = Math.round(window.screenY + (window.outerHeight - h) / 2.5);
      const popup = window.open(
        popupHref,
        'alibi-connect',
        `popup=yes,width=${w},height=${h},left=${left},top=${top}`,
      );
      // Blocked: fall through to the normal redirect.
      if (!popup) return;
      event.preventDefault();
      popup.focus();
      button.dataset.waiting = '';
      const timer = window.setInterval(() => {
        if (!popup.closed) return;
        window.clearInterval(timer);
        delete button.dataset.waiting;
      }, 400);
    });
  }

  window.addEventListener('message', (event) => {
    if (!origins.has(event.origin) || !isConnectMessage(event.data)) return;
    for (const b of buttons) delete b.dataset.waiting;
    document.dispatchEvent(new CustomEvent('alibi:connect', { detail: event.data }));
  });
</script>

<style>
  .alibi-connect {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    min-height: 48px;
    padding: var(--space-2xs) var(--space-md);
    border-radius: var(--radius-pill);
    background: var(--c-alibi);
    color: var(--c-alibi-ink);
    font: 600 var(--t-base) / 1 var(--font-sans);
    text-decoration: none;
    transition:
      filter 0.15s ease,
      transform 0.15s ease;
  }

  .alibi-connect.block {
    display: flex;
    width: 100%;
  }

  .alibi-connect:hover {
    filter: brightness(1.25);
  }

  .alibi-connect:active {
    transform: scale(0.99);
  }

  .waiting {
    display: none;
  }

  .alibi-connect[data-waiting] {
    pointer-events: none;
    opacity: 0.75;
  }

  /* :global so it also reaches the Logomark's svg, which carries another scope. */
  .alibi-connect[data-waiting] > :global(:not(.waiting)) {
    display: none;
  }

  .alibi-connect[data-waiting] .waiting {
    display: inline;
  }
</style>
